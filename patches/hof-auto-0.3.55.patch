+
+    /// A 100 m road with a car at 50 m that cannot move (held in place after every step, as a
+    /// body wedged against something would be) and another close behind it.
+    fn wedged() -> (Fixture, TrafficSim, u64, u64) {
+        let f = Fixture::new();
+        let mut net = Network { lanes: vec![street(DVec3::new(0.0, 0.0, 0.0), 0.0, 400.0)], ..Default::default() };
+        net.link(1.5);
+        let mut t = traffic(&f, net);
+        let a = add_car(&mut t, &f, 0, 50.0, 1, Some(0.0));
+        let b = add_car(&mut t, &f, 0, 40.0, 2, Some(0.0));
+        (f, t, a, b)
+    }
+
+    /// Steps of 0.5 s; the car `held` is put back where it was after every one.
+    fn tick_for(t: &mut TrafficSim, held: u64, secs: f32) {
+        let pin = t.cars.iter().find(|c| c.id == held).map(|c| (c.state.s, c.state.odometer));
+        for _ in 0..(secs / 0.5) as usize {
+            t.tick(0.5, None);
+            if let (Some((s, odo)), Some(c)) = (pin, t.cars.iter_mut().find(|c| c.id == held)) {
+                c.state.s = s;
+                c.state.odometer = odo;
+                c.state.speed = 0.0;
+            }
+        }
+    }

+    #[test]
+    fn in_the_simulation_the_wedged_car_that_holds_a_queue_goes_only_after_the_limit_and_leaves_its_place_clear() {
+        let (_f, mut t, a, b) = wedged();
+        t.unstick.force = Some(true);
+        tick_for(&mut t, a, 140.0);
+        assert!(t.cars.iter().any(|c| c.id == a) && t.cars.iter().any(|c| c.id == b), "nobody is taken off before the limit: {:?}", t.unstick.events);
+        assert_eq!(t.unstick.removed, 0);
+        let mut waited = 0.0;
+        while t.cars.iter().any(|c| c.id == a) && waited < 60.0 {
+            tick_for(&mut t, a, 5.0);
+            waited += 5.0;
+        }
+        assert!(!t.cars.iter().any(|c| c.id == a), "the wedged car, holding the other, has gone: {:?}", t.unstick.events);
+        assert_eq!(t.unstick.removed, 1, "{:?}", t.unstick.events);
+        assert!(t.admission.backing_off(0, 50.0, t.time), "no new car lands on the same blockage");
+        assert!(t.unstick.events.iter().any(|e| e.contains("took car")), "it is logged: {:?}", t.unstick.events);
+        // the one behind it is not touched, and drives on
+        tick_for(&mut t, 0, 8.0);
+        let cb = t.cars.iter().find(|c| c.id == b).expect("the car behind is still on the road");
+        assert!(cb.state.s > 45.0, "the queue moves: s = {}", cb.state.s);
+        assert_eq!(t.unstick.removed, 1);
+    }
+

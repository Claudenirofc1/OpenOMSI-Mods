diff --git a/crates/omsi-cfg/src/door_cams_file.rs b/crates/omsi-cfg/src/door_cams_file.rs
new file mode 100644
index 00000000..5259e0ef
--- /dev/null
+++ b/crates/omsi-cfg/src/door_cams_file.rs
@@ -0,0 +1,246 @@
+//! The file of the door cameras (HOF-Auto add-on): `door_cams.cfg` next to the settings, one
+//! line each, `<bus path>|on=1`, `<bus path>|all=0` and `<bus path>|cam=name;x,y,z;yaw;pitch;fov;doors;flip`.
+//! The game (`omsi-app`'s door cameras and their panel) and the launcher read and write it
+//! through here, so both always agree on the format.
+
+use std::path::{Path, PathBuf};
+
+/// A camera of the bus: where it is in the bus's frame (x right, y forward, z up), which way it
+/// looks (degrees, 0 = ahead, positive to the right; pitch positive up), its field of view,
+/// and the doors it watches.
+#[derive(Clone, Debug, PartialEq)]
+pub struct DoorCam {
+    pub name: String,
+    pub pos: [f32; 3],
+    pub yaw: f32,
+    pub pitch: f32,
+    pub fov: f32,
+    /// Door numbers as Shift+1..9 count them (1 = the first from the front).
+    pub doors: Vec<usize>,
+    /// The picture is turned over in the popup (left to right / top to bottom).
+    pub flip_x: bool,
+    pub flip_y: bool,
+}
+
+/// What the file says of one bus.
+#[derive(Clone, Debug, PartialEq)]
+pub struct BusCams {
+    pub on: bool,
+    pub all_doors: bool,
+    pub cams: Vec<DoorCam>,
+}
+
+impl Default for BusCams {
+    fn default() -> Self {
+        BusCams { on: true, all_doors: false, cams: Vec::new() }
+    }
+}
+
+/// `~/.openomsi/door_cams.cfg`.
+pub fn file() -> Option<PathBuf> {
+    let home = std::env::var_os("HOME").or_else(|| std::env::var_os("USERPROFILE"))?;
+    Some(PathBuf::from(home).join(".openomsi").join("door_cams.cfg"))
+}
+
+pub fn clean(name: &str) -> String {
+    name.chars().filter(|c| !matches!(c, '|' | '=' | ';' | '\n' | '\r')).collect::<String>().trim().to_string()
+}
+
+pub fn format_cam(c: &DoorCam) -> String {
+    let doors: Vec<String> = c.doors.iter().map(|d| d.to_string()).collect();
+    let flip = format!("{}{}", if c.flip_x { "x" } else { "" }, if c.flip_y { "y" } else { "" });
+    format!(
+        "{};{:.3},{:.3},{:.3};{:.2};{:.2};{:.1};{};{}",
+        clean(&c.name), c.pos[0], c.pos[1], c.pos[2], c.yaw, c.pitch, c.fov, doors.join(","), flip
+    )
+}
+
+pub fn parse_cam(value: &str) -> Option<DoorCam> {
+    let f: Vec<&str> = value.split(';').collect();
+    if f.len() < 5 {
+        return None;
+    }
+    let pos: Vec<f32> = f[1].split(',').filter_map(|s| s.trim().parse().ok()).collect();
+    if pos.len() != 3 {
+        return None;
+    }
+    let num = |s: &str| s.trim().parse::<f32>().ok().filter(|x| x.is_finite());
+    let doors: Vec<usize> = f.get(5).map(|s| s.split(',').filter_map(|d| d.trim().parse().ok()).filter(|d| *d >= 1).collect()).unwrap_or_default();
+    let flip = f.get(6).copied().unwrap_or("");
+    Some(DoorCam {
+        name: clean(f[0]),
+        pos: [pos[0], pos[1], pos[2]],
+        yaw: num(f[2])?,
+        pitch: num(f[3])?.clamp(-89.0, 89.0),
+        fov: num(f[4])?.clamp(20.0, 120.0),
+        doors,
+        flip_x: flip.contains('x'),
+        flip_y: flip.contains('y'),
+    })
+}
+
+/// What the launcher changes of one camera: the doors it watches, its field of view, the picture
+/// turned over, its name - or its removal. The place it looks from stays what the game wrote.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct CamEdit {
+    pub doors: Option<Vec<usize>>,
+    pub fov: Option<f32>,
+    pub flip_x: Option<bool>,
+    pub name: Option<String>,
+    pub remove: bool,
+}
+
+/// `edits[i]` applied to camera `i` (an edit with no camera is ignored); the doors are 1..=9, no repeats.
+pub fn apply_edits(b: &mut BusCams, edits: &[CamEdit]) {
+    for (i, e) in edits.iter().enumerate() {
+        let Some(c) = b.cams.get_mut(i) else { break };
+        if let Some(d) = &e.doors {
+            let mut d: Vec<usize> = d.iter().copied().filter(|n| (1..=9).contains(n)).collect();
+            d.sort_unstable();
+            d.dedup();
+            c.doors = d;
+        }
+        if let Some(f) = e.fov.filter(|f| f.is_finite()) {
+            c.fov = f.clamp(20.0, 120.0);
+        }
+        if let Some(x) = e.flip_x {
+            c.flip_x = x;
+        }
+        if let Some(n) = &e.name {
+            let n = clean(n);
+            if !n.is_empty() {
+                c.name = n;
+            }
+        }
+    }
+    let keep: Vec<bool> = (0..b.cams.len()).map(|i| !edits.get(i).is_some_and(|e| e.remove)).collect();
+    let mut k = keep.into_iter();
+    b.cams.retain(|_| k.next().unwrap_or(true));
+}
+
+/// The buses the text has lines for (as written, in the order first met).
+pub fn buses(text: &str) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    for line in text.lines() {
+        let Some((head, _)) = line.split_once('=') else { continue };
+        let Some((path, _)) = head.rsplit_once('|') else { continue };
+        let path = path.trim();
+        if !path.is_empty() && !out.iter().any(|p| p.eq_ignore_ascii_case(path)) {
+            out.push(path.to_string());
+        }
+    }
+    out
+}
+
+/// What the text says of the bus `key` (its path, any case).
+pub fn parse(text: &str, key: &str) -> BusCams {
+    let key = key.to_ascii_lowercase();
+    let mut b = BusCams::default();
+    for line in text.lines() {
+        let Some((head, value)) = line.split_once('=') else { continue };
+        let Some((path, what)) = head.rsplit_once('|') else { continue };
+        if path.trim().to_ascii_lowercase() != key {
+            continue;
+        }
+        match what.trim() {
+            "on" => b.on = value.trim() != "0",
+            "all" => b.all_doors = value.trim() == "1",
+            "cam" => b.cams.extend(parse_cam(value)),
+            _ => {}
+        }
+    }
+    b
+}
+
+/// The lines of the bus `key`.
+pub fn render(key: &str, b: &BusCams) -> Vec<String> {
+    let mut lines = vec![format!("{key}|on={}", b.on as u8), format!("{key}|all={}", b.all_doors as u8)];
+    lines.extend(b.cams.iter().map(|c| format!("{key}|cam={}", format_cam(c))));
+    lines
+}
+
+/// `text` with the bus `key`'s lines put as `b` has them and every other line left as it was.
+pub fn with_bus(text: &str, key: &str, b: &BusCams) -> String {
+    let key_l = key.to_ascii_lowercase();
+    let mut lines: Vec<String> = text
+        .lines()
+        .filter(|l| l.split_once('=').and_then(|(k, _)| k.rsplit_once('|')).is_none_or(|(f, _)| f.trim().to_ascii_lowercase() != key_l))
+        .map(str::to_string)
+        .collect();
+    lines.extend(render(key, b));
+    lines.join("\n") + "\n"
+}
+
+/// The bus's lines in the file at `path`.
+pub fn load_from(path: &Path, key: &str) -> BusCams {
+    std::fs::read_to_string(path).map(|t| parse(&t, key)).unwrap_or_default()
+}
+
+/// Write the bus's lines into the file at `path` (the rest of the file stays).
+pub fn store_to(path: &Path, key: &str, b: &BusCams) -> std::io::Result<()> {
+    let text = std::fs::read_to_string(path).unwrap_or_default();
+    if let Some(d) = path.parent() {
+        std::fs::create_dir_all(d)?;
+    }
+    std::fs::write(path, with_bus(&text, key, b))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn cam() -> DoorCam {
+        DoorCam { name: "Porta traseira".into(), pos: [1.0, -4.0, 2.0], yaw: 180.0, pitch: -20.0, fov: 70.0, doors: vec![2, 4], flip_x: true, flip_y: false }
+    }
+
+    #[test]
+    fn the_file_keeps_the_cameras_of_each_bus_apart() {
+        let a = BusCams { on: true, all_doors: true, cams: vec![cam()] };
+        let b = BusCams { on: false, all_doors: false, cams: vec![DoorCam { doors: vec![1], flip_x: false, ..cam() }] };
+        let text = with_bus(&with_bus("", "vehicles/a/a.bus", &a), "vehicles/b/b.bus", &b);
+        assert_eq!(parse(&text, "Vehicles/A/a.bus"), a);
+        assert_eq!(parse(&text, "vehicles/b/b.bus").on, false);
+        assert_eq!(buses(&text), vec!["vehicles/a/a.bus", "vehicles/b/b.bus"]);
+    }
+
+    #[test]
+    fn writing_one_bus_leaves_every_other_line_alone() {
+        let text = "# mine\nvehicles/x/x.bus|on=0\n";
+        let out = with_bus(text, "vehicles/a/a.bus", &BusCams::default());
+        assert!(out.contains("vehicles/x/x.bus|on=0"));
+        let again = with_bus(&out, "vehicles/a/a.bus", &BusCams::default());
+        assert_eq!(out, again, "writing twice changes nothing");
+    }
+
+    #[test]
+    fn a_broken_camera_line_is_skipped_not_fatal() {
+        let text = "a.bus|cam=nonsense\na.bus|cam=x;1,2;0;0;70\na.bus|cam=ok;1,2,3;10;5;70;1,2;x\n";
+        let b = parse(text, "a.bus");
+        assert_eq!(b.cams.len(), 1);
+        assert_eq!(b.cams[0].doors, vec![1, 2]);
+        assert!(b.cams[0].flip_x);
+    }
+
+    #[test]
+    fn the_launchers_edits_change_what_they_name_and_nothing_else() {
+        let mut b = BusCams { on: true, all_doors: false, cams: vec![cam(), DoorCam { name: "B".into(), ..cam() }, DoorCam { name: "C".into(), ..cam() }] };
+        let edits = [
+            CamEdit { doors: Some(vec![3, 3, 12, 1]), fov: Some(500.0), flip_x: Some(false), ..Default::default() },
+            CamEdit { remove: true, ..Default::default() },
+        ];
+        apply_edits(&mut b, &edits);
+        assert_eq!(b.cams.len(), 2);
+        assert_eq!(b.cams[0].doors, vec![1, 3]);
+        assert_eq!(b.cams[0].fov, 120.0);
+        assert!(!b.cams[0].flip_x);
+        assert_eq!(b.cams[0].pos, [1.0, -4.0, 2.0], "where it looks from stays");
+        assert_eq!(b.cams[1].name, "C", "the one removed is the second");
+    }
+
+    #[test]
+    fn a_field_of_view_and_pitch_are_kept_in_range() {
+        let b = parse("a.bus|cam=c;0,0,0;0;500;999;1\n", "a.bus");
+        assert_eq!(b.cams[0].pitch, 89.0);
+        assert_eq!(b.cams[0].fov, 120.0);
+    }
+}

+//! LOCAL MODULE (not part of upstream openOMSI): automatic depot-file (HOF) choice for a tour.
+//!
+//! Why: the official `default_hof` is given only the line name. It cannot tell a tour's real
+//! destinations from a line of the same number, so a bus can end up with a depot file that has
+//! no IBIS destination for the trips it drives (see local/MODIFICACOES_LOCAIS.md).
+//!
+//! What it does, for the tour that is chosen:
+//!   0. the AI group of the tour (2nd field of `[newtour]`) names a depot group of the map's
+//!      `ailists.cfg`; that group's HOF is the one the map *declares* for the tour;
+//!   1. every distinct trip of the tour has a destination (the trip's terminus); a HOF *covers*
+//!      the tour only when every one of them is found in it as an identifier (`texture_id`) or
+//!      as its `terminus_stop`, after the same whitespace/Unicode-lowercase normalisation the
+//!      official matcher uses. A match on a displayed string alone is weak (it is line-blind)
+//!      and a prefix match is weaker: neither proves anything;
+//!   2. the declared HOF wins when it covers; when it does not but others do, or when several
+//!      cover with nothing to tell them apart, the answer is AMBIGUOUS and the launch is
+//!      blocked (never a silent pick); when nothing covers, the answer is NO MATCH and the
+//!      official choice is kept but never labelled as proven.
+//! A line number on its own is never proof.
+//!
+//! Switch: environment variable `OPENOMSI_HOF_AUTO=off` (also `0`, `false`, `no`, `official`)
+//! restores the official behaviour; nothing on disk is read or written for it.
+//!
+//! The decision core ([`evaluate`]) is pure (HOF values in, decision out) so that it can be
+//! tested without an OMSI installation. The glue to the launcher is [`auto_for`].
+use omsi_vehicle::hof::{terminus_match_score, trip_terminus};
+use omsi_vehicle::Hof;
+use serde::Serialize;
+use std::path::PathBuf;
+
+/// The environment variable that turns the module off.
+pub const ENV_SWITCH: &str = "OPENOMSI_HOF_AUTO";
+
+/// Whether the module is on (the default in this prototype).
+pub fn enabled() -> bool {
+    match std::env::var(ENV_SWITCH).ok() {
+        Some(v) => !switched_off(Some(&v)),
+        // (the installer's check box: `hof_auto=0` in `hofauto-mods.cfg`)
+        None => omsi_cfg::addon_switch::enabled("hof_auto"),
+    }
+}
+
+pub(crate) fn switched_off(value: Option<&str>) -> bool {
+    matches!(value.map(|v| v.trim().to_ascii_lowercase()).as_deref(), Some("off" | "0" | "false" | "no" | "official"))
+}
+
+/// What the tour needs from a HOF: one distinct trip.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Need {
+    pub name: String,
+    pub line: String,
+    pub terminus: String,
+    pub stops: Vec<String>,
+}
+
+/// How well one HOF holds one destination (the higher the stronger).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize)]
+pub enum Level {
+    None = 0,
+    /// Word-boundary prefix only.
+    Prefix = 1,
+    /// Equal to a displayed string only (the strings are line-blind).
+    Displayed = 2,
+    /// Equal to the identifier or the terminus stop after normalisation.
+    Normalized = 3,
+    /// Identifier identical, byte for byte (after trimming the wanted text).
+    Exact = 4,
+}
+
+impl Level {
+    pub fn word(self) -> &'static str {
+        match self {
+            Level::None => "NONE",
+            Level::Prefix => "PREFIX",
+            Level::Displayed => "DISPLAYED_TEXT",
+            Level::Normalized => "NORMALIZED",
+            Level::Exact => "EXACT",
+        }
+    }
+    /// Only these two prove that the HOF has the destination.
+    pub fn proves(self) -> bool {
+        self >= Level::Normalized
+    }
+}
+
+/// A message in the launcher's language (keys are the English texts, `crates/omsi-app/locales/hof_auto.yml`).
+fn m(key: &str, vars: &[(&str, &dyn std::fmt::Display)]) -> String {
+    crate::i18n::trf(key, vars)
+}
+
+impl Level {
+    /// The level in words for the person.
+    pub fn label(self) -> String {
+        match self {
+            Level::None => m("no match", &[]),
+            Level::Prefix => m("prefix", &[]),
+            Level::Displayed => m("displayed text", &[]),
+            Level::Normalized => m("same name", &[]),
+            Level::Exact => m("exact", &[]),
+        }
+    }
+}
+
+fn norm(s: &str) -> String {
+    // the official normalisation of `terminus_match_score`: whitespace collapsed, Unicode
+    // lowercase, no accent folding
+    s.split_whitespace().collect::<Vec<_>>().join(" ").to_lowercase()
+}
+
+/// How `hof` holds destination `wanted`.
+pub fn level(hof: &Hof, wanted: &str) -> Level {
+    let w = wanted.trim();
+    if w.is_empty() {
+        return Level::None;
+    }
+    if hof.termini.iter().any(|t| t.texture_id == w) {
+        return Level::Exact;
+    }
+    let wn = norm(wanted);
+    let mut best = Level::None;
+    for t in &hof.termini {
+        if norm(&t.texture_id) == wn || t.terminus_stop.as_deref().map(norm).as_deref() == Some(wn.as_str()) {
+            best = best.max(Level::Normalized);
+        } else if t.strings.iter().any(|x| norm(x) == wn) {
+            best = best.max(Level::Displayed);
+        } else if terminus_match_score(t, wanted) == 1 {
+            best = best.max(Level::Prefix);
+        }
+    }
+    best
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+pub enum Status {
+    /// The declared HOF covers the whole tour.
+    ProvenDeclared,
+    /// No HOF declared; exactly one covers.
+    ProvenUnique,
+    /// No HOF declared; several cover and one is stronger on every trip.
+    ProvenTieBreak,
+    /// The declared HOF has the destinations only as weak matches: kept, not confirmed.
+    FlexibleDeclared,
+    /// Others cover but the declared one does not, or several cover with nothing to choose by.
+    Ambiguous,
+    /// No HOF covers the tour: the official choice is kept, not proven.
+    NoMatch,
+    /// The tour has no trip with a destination to check.
+    NoTrips,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+pub enum Severity {
+    Ok,
+    Warn,
+    Block,
+}
+
+impl Status {
+    pub fn is_proven(self) -> bool {
+        matches!(self, Status::ProvenDeclared | Status::ProvenUnique | Status::ProvenTieBreak)
+    }
+    pub fn severity(self) -> Severity {
+        match self {
+            Status::ProvenDeclared | Status::ProvenUnique | Status::ProvenTieBreak => Severity::Ok,
+            Status::FlexibleDeclared | Status::NoMatch | Status::NoTrips => Severity::Warn,
+            Status::Ambiguous => Severity::Block,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct Decision {
+    pub status: Status,
+    /// The HOF the algorithm picked (its `[name]`); None when it picked none.
+    pub hof: Option<String>,
+    /// How the picked HOF holds the weakest destination of the tour.
+    pub level: Level,
+    /// Every HOF that covers the whole tour, with its weakest level.
+    pub proven: Vec<(String, Level)>,
+    /// A sentence for the person (and the log).
+    pub message: String,
+}
+
+/// The HOFs of `hofs` that carry the same `[name]` (the game is given `--hof <name>`, so it
+/// cannot tell them apart) with their files, and whether their bytes are identical.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub struct DuplicateName {
+    pub name: String,
+    pub files: Vec<PathBuf>,
+    /// All the copies hold the same bytes: harmless. Unreadable files count as different.
+    pub identical: bool,
+}
+
+pub fn duplicate_names(hofs: &[&Hof]) -> Vec<DuplicateName> {
+    let mut by_name: std::collections::BTreeMap<String, Vec<&Hof>> = Default::default();
+    for h in hofs {
+        by_name.entry(h.name.trim().to_lowercase()).or_default().push(h);
+    }
+    let mut out = Vec::new();
+    for (name, list) in by_name {
+        let mut paths: Vec<PathBuf> = list.iter().map(|h| h.path.clone()).collect();
+        paths.sort();
+        paths.dedup();
+        if paths.len() < 2 {
+            continue;
+        }
+        let bytes: Vec<Option<Vec<u8>>> = paths.iter().map(|p| std::fs::read(p).ok()).collect();
+        let identical = bytes.iter().all(|b| b.is_some()) && bytes.windows(2).all(|w| w[0] == w[1]);
+        out.push(DuplicateName { name, files: paths, identical });
+    }
+    out
+}
+
+/// The decision core. `declared` is the HOF name the map declares for the tour's AI group.
+pub fn evaluate(declared: Option<&str>, needs: &[Need], hofs: &[&Hof]) -> Decision {
+    let judged: Vec<&Need> = needs.iter().filter(|n| !n.terminus.trim().is_empty()).collect();
+    let name_of = |i: usize| hofs[i].name.trim().to_string();
+    let declared = declared.map(str::trim).filter(|d| !d.is_empty());
+    let decl_idx = declared.and_then(|d| hofs.iter().position(|h| h.name.trim().eq_ignore_ascii_case(d)));
+    if judged.is_empty() {
+        return Decision {
+            status: Status::NoTrips,
+            // (nothing to check it against: the official choice stays, flagged as not confirmed)
+            hof: None,
+            level: Level::None,
+            proven: vec![],
+            message: m("The tour has no trip with a destination to check; the depot file is not confirmed.", &[]),
+        };
+    }
+    // weakest level over the tour, and the number of trips with an IBIS route, per HOF
+    let mut weakest = vec![Level::Exact; hofs.len()];
+    let mut routes = vec![0usize; hofs.len()];
+    for (i, h) in hofs.iter().enumerate() {
+        for n in &judged {
+            let lv = level(h, &n.terminus);
+            weakest[i] = weakest[i].min(lv);
+            if lv.proves() {
+                let stops: Vec<&str> = n.stops.iter().map(|s| s.as_str()).collect();
+                if matches!(trip_terminus(h, &n.line, &n.terminus, &stops), Some((_, Some(_)))) {
+                    routes[i] += 1;
+                }
+            }
+        }
+    }
+    let proven_idx: Vec<usize> = (0..hofs.len()).filter(|&i| weakest[i].proves()).collect();
+    let proven: Vec<(String, Level)> = proven_idx.iter().map(|&i| (name_of(i), weakest[i])).collect();
+    let weak_idx: Vec<usize> = (0..hofs.len()).filter(|&i| weakest[i] >= Level::Prefix).collect();
+    let n = judged.len();
+    let pick = |status: Status, i: usize, message: String| Decision { status, hof: Some(name_of(i)), level: weakest[i], proven: proven.clone(), message };
+    if let Some(d) = decl_idx.filter(|d| proven_idx.contains(d)) {
+        return pick(Status::ProvenDeclared, d, m("Depot file {hof} (declared by the map for the tour's group) has every destination of the tour.", &[("hof", &name_of(d))]));
+    }
+    if !proven_idx.is_empty() {
+        let list = proven.iter().map(|(n, l)| format!("{n} [{}]", l.label())).collect::<Vec<_>>().join(", ");
+        if let Some(d) = decl_idx {
+            return Decision {
+                status: Status::Ambiguous,
+                hof: None,
+                level: Level::None,
+                proven: proven.clone(),
+                message: m("The map declares {hof} for this tour but it does not hold every destination ({level}); these do: {list}. Choose the depot file by hand.", &[("hof", &name_of(d)), ("level", &weakest[d].label()), ("list", &list)]),
+            };
+        }
+        if proven_idx.len() == 1 {
+            let i = proven_idx[0];
+            return pick(Status::ProvenUnique, i, m("Depot file {hof} is the only one with every destination of the tour (the map declares none).", &[("hof", &name_of(i))]));
+        }
+        let best = proven_idx.iter().map(|&i| (weakest[i], routes[i] == n)).max().unwrap_or((Level::None, false));
+        let top: Vec<usize> = proven_idx.iter().copied().filter(|&i| (weakest[i], routes[i] == n) == best).collect();
+        if top.len() == 1 {
+            return pick(Status::ProvenTieBreak, top[0], m("Several depot files have every destination ({list}); {hof} is stronger on all of them.", &[("list", &list), ("hof", &name_of(top[0]))]));
+        }
+        return Decision { status: Status::Ambiguous, hof: None, level: Level::None, proven: proven.clone(), message: m("Several depot files have every destination of the tour with nothing to tell them apart: {list}. Choose the depot file by hand.", &[("list", &list)]) };
+    }
+    if let Some(d) = decl_idx.filter(|d| weak_idx.contains(d)) {
+        return pick(Status::FlexibleDeclared, d, m("Depot file {hof} is the map's, but it holds the destinations only as {level} matches: not confirmed.", &[("hof", &name_of(d)), ("level", &weakest[d].label())]));
+    }
+    let message = if weak_idx.is_empty() {
+        m("No depot file holds the destinations of this tour; the usual choice is kept but it is NOT confirmed.", &[])
+    } else {
+        m("{n} depot file(s) match the destinations only partially; the usual choice is kept but it is NOT confirmed.", &[("n", &weak_idx.len())])
+    };
+    Decision { status: Status::NoMatch, hof: None, level: Level::None, proven: vec![], message }
+}
+
+/// The HOF the map declares for AI group `group` on `day` (YYYYMMDD): the `[aigroup_depot]` of
+/// that name in the map's `ailists.cfg`, as the active chrono scenarios change it.
+pub fn declared_depot(map_dir: &std::path::Path, day: i32, group: &str) -> Option<String> {
+    let group = group.trim();
+    let lists = omsi_map::ailists::ailists_with_chrono(map_dir, &omsi_map::ailists::active_chrono_dirs(map_dir, day));
+    lists.groups.iter().find(|g| g.name.trim().eq_ignore_ascii_case(group) && g.hof.is_some()).and_then(|g| g.hof.clone())
+}
+
+/// The answer of [`auto_for`], in the form the launcher shows.
+#[derive(Clone, Debug, Serialize)]
+pub struct Auto {
+    /// The depot file to use: the algorithm's pick, else the official choice.
+    pub hof: String,
+    /// "hof_auto" or "official" (module off, no tour, no data).
+    pub engine: &'static str,
+    pub status: Option<Status>,
+    pub severity: Severity,
+    /// Launching is blocked until the depot file is chosen by hand.
+    pub block: bool,
+    /// The choice is backed by the tour's own destinations.
+    pub proven: bool,
+    pub message: String,
+    /// Depot files that cover the tour (the person's options when blocked).
+    pub candidates: Vec<String>,
+    /// Depot files sharing a `[name]` with different content among the ones that matter.
+    pub duplicates: Vec<DuplicateName>,
+}
+
+fn official(hof: String, message: &str) -> Auto {
+    Auto { hof, engine: "official", status: None, severity: Severity::Ok, block: false, proven: false, message: message.into(), candidates: vec![], duplicates: vec![] }
+}
+
+/// The depot file for the tour `tour` (its selection id) of line `line`, as the launcher asks.
+/// Never panics and never reads more than the official code reads; any missing piece of data
+/// falls back to the official choice with `engine: "official"`.
+pub fn auto_for(map: Option<&crate::MapInfo>, bus: Option<&crate::VehicleInfo>, date: &str, line: Option<&str>, tour: Option<&str>) -> Auto {
+    if !enabled() {
+        return official(crate::default_hof(map, bus, date, line), &m("OPENOMSI_HOF_AUTO is off: the official choice is used.", &[]));
+    }
+    let found = (|| {
+        let lines = crate::list_lines(&map?.file, date).ok()?;
+        lines.into_iter().find(|l| Some(l.name.as_str()) == line)?.tour(tour?).cloned()
+    })();
+    auto_for_tour(map, bus, date, line, found.as_ref())
+}
+
+/// [`auto_for`] when the caller already holds the tour (the native launcher has its lines).
+pub fn auto_for_tour(map: Option<&crate::MapInfo>, bus: Option<&crate::VehicleInfo>, date: &str, line: Option<&str>, tour: Option<&crate::TourInfo>) -> Auto {
+    let legacy = crate::default_hof(map, bus, date, line);
+    if !enabled() {
+        return official(legacy, &m("OPENOMSI_HOF_AUTO is off: the official choice is used.", &[]));
+    }
+    let (Some(map), Some(bus), Some(tour)) = (map, bus, tour) else { return official(legacy, "") };
+    let dir_of = |rel: &str| crate::resolve_content(rel).ok().and_then(|f| f.parent().map(|p| p.to_path_buf()));
+    let (Some(map_dir), Some(bus_dir)) = (dir_of(&map.file), dir_of(&bus.file)) else { return official(legacy, "") };
+    auto_for_paths(&map_dir, &bus_dir, date, tour, legacy)
+}
+
+/// The glue below the path lookups: everything that reads the map's `ailists.cfg` and the depot
+/// files the bus sees (its folder, then the shared `HOFs`). `legacy` is the official choice.
+pub fn auto_for_paths(dir: &std::path::Path, bus_dir: &std::path::Path, date: &str, tour: &crate::TourInfo, legacy: String) -> Auto {
+    let Some(day) = omsi_map::ailists::date_code(date) else { return official(legacy, "") };
+    let declared = declared_depot(dir, day, &tour.ai_group);
+    let mut seen = std::collections::HashSet::new();
+    let needs: Vec<Need> = tour
+        .trips
+        .iter()
+        .filter(|t| seen.insert(t.name.to_lowercase()))
+        .map(|t| Need { name: t.name.clone(), line: t.line.trim().to_string(), terminus: t.terminus.trim().to_string(), stops: t.stops.iter().map(|s| s.name.trim().to_string()).collect() })
+        .collect();
+    let files = omsi_vehicle::hof::depot_files(bus_dir);
+    let loaded: Vec<Hof> = files.iter().filter_map(|p| cached_load(p)).collect();
+    // the names the bus offers (its own, then the shared ones), each name once, as the game resolves it
+    let refs = unique_by_name(&loaded);
+    if refs.is_empty() {
+        return official(legacy, "");
+    }
+    let d = evaluate(declared.as_deref(), &needs, &refs);
+    let dups: Vec<DuplicateName> = duplicate_names(&loaded.iter().collect::<Vec<_>>())
+        .into_iter()
+        .filter(|x| !x.identical && (d.proven.iter().any(|(n, _)| n.eq_ignore_ascii_case(&x.name)) || d.hof.as_deref().is_some_and(|h| h.eq_ignore_ascii_case(&x.name)) || declared.as_deref().is_some_and(|h| h.trim().eq_ignore_ascii_case(&x.name))))
+        .collect();
+    let mut message = d.message.clone();
+    let mut severity = d.status.severity();
+    if !dups.is_empty() {
+        let list = dups.iter().map(|x| m("{name} ({n} files)", &[("name", &x.name), ("n", &x.files.len())])).collect::<Vec<_>>().join(", ");
+        message.push(' ');
+        message.push_str(&m("Warning: more than one depot file is called {list} with different content; the game picks by name and may use another file than the one checked.", &[("list", &list)]));
+        severity = severity.max_with(Severity::Warn);
+    }
+    let block = severity == Severity::Block;
+    let hof = d.hof.clone().unwrap_or(legacy);
+    Auto { hof, engine: "hof_auto", status: Some(d.status), severity, block, proven: d.status.is_proven() && dups.is_empty(), message, candidates: d.proven.iter().map(|(n, _)| n.clone()).collect(), duplicates: dups }
+}
+
+impl Severity {
+    fn max_with(self, o: Severity) -> Severity {
+        fn rank(s: Severity) -> u8 {
+            match s {
+                Severity::Ok => 0,
+                Severity::Warn => 1,
+                Severity::Block => 2,
+            }
+        }
+        if rank(o) > rank(self) {
+            o
+        } else {
+            self
+        }
+    }
+}
+
+/// Each `[name]` once, the first file (the bus's own before the shared ones) winning, as the game resolves a name.
+pub fn unique_by_name(hofs: &[Hof]) -> Vec<&Hof> {
+    let mut names = std::collections::HashSet::new();
+    hofs.iter().filter(|h| names.insert(h.name.trim().to_lowercase())).collect()
+}
+
+/// `Hof::load` once per file and content generation (the launcher asks on every change).
+fn cached_load(p: &std::path::Path) -> Option<Hof> {
+    type Cache = std::collections::HashMap<PathBuf, Option<Hof>>;
+    static CACHE: std::sync::OnceLock<std::sync::Mutex<(u64, Cache)>> = std::sync::OnceLock::new();
+    let cache = CACHE.get_or_init(Default::default);
+    let generation = omsi_cfg::content_generation();
+    let mut c = cache.lock().unwrap_or_else(|e| e.into_inner());
+    if c.0 != generation {
+        *c = (generation, Cache::new());
+    }
+    c.1.entry(p.to_path_buf()).or_insert_with(|| Hof::load(p).ok()).clone()
+}

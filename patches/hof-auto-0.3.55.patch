diff --git a/crates/omsi-cfg/src/addon_switch.rs b/crates/omsi-cfg/src/addon_switch.rs
new file mode 100644
index 00000000..fb8ecc76
--- /dev/null
+++ b/crates/omsi-cfg/src/addon_switch.rs
@@ -0,0 +1,141 @@
+//! On/off switches of the HOF-Auto add-ons (hof_auto, door_cams, dashcam, ...): the installer's
+//! check boxes write them into `hofauto-mods.cfg` next to the settings (`name=1` / `name=0`, `#`
+//! starts a comment), the game reads them while it runs. A name that is not there is on. The
+//! environment variable `OPENOMSI_<NAME>` (`off`, `0`, `false`, `no`) overrides the file, for a
+//! quick test. The file is read again every few seconds, so a change needs no restart.
+
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+/// How long what was read is kept.
+const KEEP: Duration = Duration::from_secs(3);
+
+/// `name`'s switch in `text`, if it has one.
+pub fn parse(text: &str, name: &str) -> Option<bool> {
+    text.lines()
+        .map(|l| l.split('#').next().unwrap_or("").trim())
+        .filter_map(|l| l.split_once('='))
+        .filter(|(k, _)| k.trim().eq_ignore_ascii_case(name))
+        .map(|(_, v)| !matches!(v.trim().to_ascii_lowercase().as_str(), "0" | "off" | "false" | "no"))
+        .next_back()
+}
+
+/// `text` with the switch `name` put to `on`: its line changed in place (comments and every other
+/// line stay), or added at the end.
+pub fn with_switch(text: &str, name: &str, on: bool) -> String {
+    let value = format!("{name}={}", on as u8);
+    let mut done = false;
+    let mut lines: Vec<String> = text
+        .lines()
+        .map(|l| {
+            let code = l.split('#').next().unwrap_or("");
+            match code.split_once('=') {
+                Some((k, _)) if k.trim().eq_ignore_ascii_case(name) => {
+                    done = true;
+                    value.clone()
+                }
+                _ => l.to_string(),
+            }
+        })
+        .collect();
+    if !done {
+        lines.push(value);
+    }
+    lines.join("\n") + "\n"
+}
+
+/// Put the switch `name` to `on` in the file (the game reads it again within seconds).
+pub fn set(name: &str, on: bool) -> std::io::Result<()> {
+    let path = file().ok_or_else(|| std::io::Error::other("no home folder"))?;
+    let text = std::fs::read_to_string(&path).unwrap_or_default();
+    if let Some(d) = path.parent() {
+        std::fs::create_dir_all(d)?;
+    }
+    std::fs::write(&path, with_switch(&text, name, on))?;
+    *CACHE.lock().unwrap_or_else(|e| e.into_inner()) = None;
+    Ok(())
+}
+
+/// What the file says of `name` now: its switch, on when it has none.
+pub fn read(name: &str) -> bool {
+    let var = format!("OPENOMSI_{}", name.to_ascii_uppercase());
+    if let Some(v) = from_env(name, std::env::var(&var).ok().as_deref()) {
+        return v;
+    }
+    file().and_then(|f| std::fs::read_to_string(f).ok()).and_then(|t| parse(&t, name)).unwrap_or(true)
+}
+
+/// The environment variable's say on `name`, if it says.
+fn from_env(name: &str, value: Option<&str>) -> Option<bool> {
+    let _ = name;
+    value.map(|v| !matches!(v.trim().to_ascii_lowercase().as_str(), "off" | "0" | "false" | "no" | "official"))
+}
+
+/// The file's path: `~/.openomsi/hofauto-mods.cfg`.
+pub fn file() -> Option<std::path::PathBuf> {
+    let home = std::env::var_os("USERPROFILE").or_else(|| std::env::var_os("HOME"))?;
+    Some(std::path::PathBuf::from(home).join(".openomsi").join("hofauto-mods.cfg"))
+}
+
+static CACHE: Mutex<Option<(Instant, String)>> = Mutex::new(None);
+
+/// Whether the add-on `name` is on: the environment, else the file, else on.
+pub fn enabled(name: &str) -> bool {
+    let var = format!("OPENOMSI_{}", name.to_ascii_uppercase());
+    if let Some(v) = from_env(name, std::env::var(&var).ok().as_deref()) {
+        return v;
+    }
+    let mut g = CACHE.lock().unwrap_or_else(|e| e.into_inner());
+    if g.as_ref().is_none_or(|(t, _)| t.elapsed() >= KEEP) {
+        let text = file().and_then(|f| std::fs::read_to_string(f).ok()).unwrap_or_default();
+        *g = Some((Instant::now(), text));
+    }
+    g.as_ref().and_then(|(_, t)| parse(t, name)).unwrap_or(true)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_switch_is_changed_in_place_and_the_rest_stays() {
+        let text = "# my choices\nhof_auto=1\ndoor_cams = 1 # popup\n";
+        let out = with_switch(text, "door_cams", false);
+        assert_eq!(out, "# my choices\nhof_auto=1\ndoor_cams=0\n");
+        assert_eq!(parse(&out, "door_cams"), Some(false));
+        assert_eq!(parse(&out, "hof_auto"), Some(true));
+        let added = with_switch(&out, "dashcam", true);
+        assert!(added.ends_with("dashcam=1\n") && added.starts_with("# my choices\n"));
+        assert_eq!(with_switch(&added, "dashcam", true), added, "twice the same");
+    }
+
+    #[test]
+    fn a_name_that_is_not_in_the_file_is_on() {
+        assert_eq!(parse("", "dashcam"), None);
+        assert_eq!(parse("door_cams=0\n", "dashcam"), None);
+    }
+
+    #[test]
+    fn the_file_turns_each_add_on_on_or_off() {
+        let t = "# the installer's choice\nhof_auto=1\ndoor_cams = 0   # not for me\nDashCam=off\nunstick=1\n";
+        assert_eq!(parse(t, "hof_auto"), Some(true));
+        assert_eq!(parse(t, "door_cams"), Some(false));
+        assert_eq!(parse(t, "dashcam"), Some(false));
+        assert_eq!(parse(t, "unstick"), Some(true));
+    }
+
+    #[test]
+    fn the_last_line_for_a_name_counts() {
+        assert_eq!(parse("a=0\na=1\n", "a"), Some(true));
+        assert_eq!(parse("a=1\na=0\n", "a"), Some(false));
+    }
+
+    #[test]
+    fn the_environment_says_off_in_the_words_the_hof_switch_knows() {
+        for off in ["off", "0", "false", "no", "official", " OFF "] {
+            assert_eq!(from_env("x", Some(off)), Some(false), "{off}");
+        }
+        assert_eq!(from_env("x", Some("on")), Some(true));
+        assert_eq!(from_env("x", None), None);
+    }
+}
diff --git a/crates/omsi-cfg/src/dashcam_file.rs b/crates/omsi-cfg/src/dashcam_file.rs
new file mode 100644
index 00000000..d7739013
--- /dev/null
+++ b/crates/omsi-cfg/src/dashcam_file.rs
@@ -0,0 +1,135 @@
+//! The dashcam's file (HOF-Auto add-on): `dashcam.cfg` next to the settings, per bus
+//! `<bus path>|cam=x,y,z;yaw;pitch;fov`, `<bus path>|look=clean|cctv` and `<bus path>|name=...`.
+//! The game places the camera; the launcher changes the field of view, the look and the name
+//! through here, and every other line stays as it was.
+
+/// What the launcher shows of one bus's dashcam.
+#[derive(Clone, Debug, PartialEq)]
+pub struct DashEntry {
+    pub bus: String,
+    pub fov: f32,
+    pub cctv: bool,
+    pub name: String,
+}
+
+fn split(line: &str) -> Option<(&str, &str, &str)> {
+    let (head, value) = line.split_once('=')?;
+    let (path, what) = head.rsplit_once('|')?;
+    Some((path.trim(), what.trim(), value))
+}
+
+/// The same cleaning of a name the game does: no separators, 24 characters at most.
+pub fn clean_name(name: &str) -> String {
+    let n: String = name.chars().filter(|ch| !matches!(ch, '|' | '=' | '\n' | '\r' | ';' | ':' | '\'' | '%' | '\\')).take(24).collect();
+    if n.trim().is_empty() { "CAM 1".into() } else { n }
+}
+
+/// The buses that have a camera placed.
+pub fn list(text: &str) -> Vec<DashEntry> {
+    let mut out: Vec<DashEntry> = Vec::new();
+    for line in text.lines() {
+        let Some((bus, what, value)) = split(line) else { continue };
+        if what != "cam" || out.iter().any(|e| e.bus.eq_ignore_ascii_case(bus)) {
+            continue;
+        }
+        let fov = value.split(';').nth(3).and_then(|s| s.trim().parse::<f32>().ok()).filter(|f| f.is_finite());
+        let Some(fov) = fov else { continue };
+        let mut e = DashEntry { bus: bus.to_string(), fov: fov.clamp(20.0, 120.0), cctv: false, name: "CAM 1".into() };
+        for l in text.lines() {
+            let Some((b, w, v)) = split(l) else { continue };
+            if !b.eq_ignore_ascii_case(bus) {
+                continue;
+            }
+            match w {
+                "look" => e.cctv = v.trim().eq_ignore_ascii_case("cctv"),
+                "name" => e.name = v.trim().to_string(),
+                _ => {}
+            }
+        }
+        out.push(e);
+    }
+    out
+}
+
+/// `text` with the field of view, the look and/or the name of `bus` changed; the bus's other
+/// lines and every other bus stay. A bus with no camera placed is left alone.
+pub fn edit(text: &str, bus: &str, fov: Option<f32>, cctv: Option<bool>, name: Option<&str>) -> String {
+    if !list(text).iter().any(|e| e.bus.eq_ignore_ascii_case(bus)) {
+        return text.to_string();
+    }
+    let mut seen = (false, false);
+    let mut lines: Vec<String> = text
+        .lines()
+        .map(|l| {
+            let Some((b, what, value)) = split(l) else { return l.to_string() };
+            if !b.eq_ignore_ascii_case(bus) {
+                return l.to_string();
+            }
+            match (what, fov, cctv, name) {
+                ("cam", Some(f), _, _) if f.is_finite() => {
+                    let mut parts: Vec<String> = value.split(';').map(|s| s.to_string()).collect();
+                    if parts.len() >= 4 {
+                        parts[3] = format!("{:.1}", f.clamp(30.0, 110.0));
+                        return format!("{b}|cam={}", parts.join(";"));
+                    }
+                    l.to_string()
+                }
+                ("look", _, Some(c), _) => {
+                    seen.0 = true;
+                    format!("{b}|look={}", if c { "cctv" } else { "clean" })
+                }
+                ("name", _, _, Some(n)) => {
+                    seen.1 = true;
+                    format!("{b}|name={}", clean_name(n))
+                }
+                _ => l.to_string(),
+            }
+        })
+        .collect();
+    if let (false, Some(c)) = (seen.0, cctv) {
+        lines.push(format!("{bus}|look={}", if c { "cctv" } else { "clean" }));
+    }
+    if let (false, Some(n)) = (seen.1, name) {
+        lines.push(format!("{bus}|name={}", clean_name(n)));
+    }
+    lines.join("\n") + "\n"
+}
+
+/// `~/.openomsi/dashcam.cfg`.
+pub fn file() -> Option<std::path::PathBuf> {
+    let home = std::env::var_os("HOME").or_else(|| std::env::var_os("USERPROFILE"))?;
+    Some(std::path::PathBuf::from(home).join(".openomsi").join("dashcam.cfg"))
+}
+
+#[cfg(test)]
+mod tests {

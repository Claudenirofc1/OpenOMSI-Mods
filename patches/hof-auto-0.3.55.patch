+#[cfg(test)]
+mod tests {
+    use super::*;
+    use omsi_vehicle::hof::{InfoTrip, Terminus};
+
+    fn term(id: &str, stop: Option<&str>, shown: &[&str]) -> Terminus {
+        Terminus { code: 100, texture_id: id.into(), terminus_stop: stop.map(Into::into), all_exit: false, strings: shown.iter().map(|s| s.to_string()).collect() }
+    }
+    fn hof(name: &str, termini: Vec<Terminus>) -> Hof {
+        Hof { name: name.into(), termini, ..Default::default() }
+    }
+    fn need(name: &str, terminus: &str) -> Need {
+        Need { name: name.into(), line: "1".into(), terminus: terminus.into(), stops: vec![] }
+    }
+
+    #[test]
+    fn switch_words() {
+        for w in ["off", "OFF", " 0 ", "false", "no", "official"] {
+            assert!(switched_off(Some(w)), "{w}");
+        }
+        for w in ["on", "1", "", "auto"] {
+            assert!(!switched_off(Some(w)), "{w}");
+        }
+        assert!(!switched_off(None));
+    }
+
+    #[test]
+    fn levels() {
+        let h = hof("A", vec![term("101 Divisa", Some("101 Divisa"), &["TERMINAL", "DIVISA"])]);
+        assert_eq!(level(&h, "101 Divisa"), Level::Exact);
+        assert_eq!(level(&h, "  101   divisa "), Level::Normalized);
+        assert_eq!(level(&h, "101 Divisá"), Level::None, "no accent folding, as the official matcher");
+        assert_eq!(level(&h, "DIVISA"), Level::Displayed, "a displayed string alone is weak");
+        assert_eq!(level(&h, "101"), Level::Prefix);
+        assert_eq!(level(&h, ""), Level::None);
+        assert!(!Level::Displayed.proves() && !Level::Prefix.proves());
+    }
+
+    #[test]
+    fn declared_hof_that_covers_wins() {
+        let a = hof("A", vec![term("X", None, &["X"]), term("Y", None, &["Y"])]);
+        let b = hof("B", vec![term("X", None, &["X"]), term("Y", None, &["Y"])]);
+        let d = evaluate(Some("b"), &[need("t1", "X"), need("t2", "Y")], &[&a, &b]);
+        assert_eq!(d.status, Status::ProvenDeclared);
+        assert_eq!(d.hof.as_deref(), Some("B"));
+        assert_eq!(d.proven.len(), 2);
+    }
+
+    #[test]
+    fn declared_that_does_not_cover_while_another_does_is_ambiguous_and_blocks() {
+        let a = hof("A", vec![term("X", None, &["X"])]);
+        let b = hof("B", vec![term("X", None, &["X"]), term("Y", None, &["Y"])]);
+        let d = evaluate(Some("A"), &[need("t1", "X"), need("t2", "Y")], &[&a, &b]);
+        assert_eq!(d.status, Status::Ambiguous);
+        assert!(d.hof.is_none());
+        assert_eq!(d.status.severity(), Severity::Block);
+    }
+
+    #[test]
+    fn one_hof_missing_a_trip_does_not_cover_the_tour() {
+        let a = hof("A", vec![term("X", None, &["X"])]);
+        let d = evaluate(Some("A"), &[need("t1", "X"), need("t2", "Y")], &[&a]);
+        assert_eq!(d.status, Status::NoMatch, "partial coverage is never proof");
+        assert!(!d.status.is_proven());

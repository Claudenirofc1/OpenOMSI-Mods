diff --git a/crates/omsi-sim/src/ai_traffic/unstick.rs b/crates/omsi-sim/src/ai_traffic/unstick.rs
new file mode 100644
index 00000000..4a4dc369
--- /dev/null
+++ b/crates/omsi-sim/src/ai_traffic/unstick.rs
@@ -0,0 +1,703 @@
+//! Optional recovery of AI traffic that has stopped for good (add-on `ai_unstick`, switched
+//! with `ai_unstick=0` in `hofauto-mods.cfg`; on by default where the file does not say).
+//!
+//! It sits on top of what the game already does (`deadlock` sorts out circles of cars that
+//! wait on each other by the rules, `GIVE_UP_STOOD` drops a random car that has stood for 200 s,
+//! `lateral` goes round what stands in the lane) and acts only where all of that has not
+//! been enough. Time standing is never a reason by itself:
+//!
+//! - A car is *investigated* once it has made no progress (2 m) for
+//!   `max(150 s, 2.5 x the longest red of the map's lights)` of time in which nothing
+//!   legitimate held it: seconds at a red light, at a stop of a timetable bus, for people
+//!   crossing, for the player's vehicle, while overtaking or parking, are not counted.
+//! - It is a *culprit* only when it is the head of what stands (nobody ahead of it that
+//!   moves or legitimately waits), or one of a circle that holds each other, and it has been
+//!   confirmed on `CONFIRM_SCANS` scans in a row.
+//! - Only the culprit goes, only when nobody can see it vanish (`TrafficSim::unseen`), never a
+//!   timetable bus, never the player's vehicle (it is not an AI car), never a car that waits for
+//!   a light that cycles or stands legitimately. The cars behind it get `VERIFY` seconds to
+//!   move; only if they stand on for that long is the next culprit looked for.
+//! - The place is kept clear of new cars for `KEEP_CLEAR` seconds (the population's own
+//!   backoff), so no car lands on the same blockage.
+//! - Every decision is logged (`ai-unstick:` lines in the game log).
+//!
+//! The decision (`Unstick::scan`) works on plain snapshots so it is tested without the world.
+
+use super::*;
+
+/// Seconds without progress before a car is looked at, at least.
+pub const FLOOR: f32 = 150.0;
+/// ... or this many times the longest red light of the map.
+pub const FACTOR: f32 = 2.5;
+/// The limit when the map has lights whose timing cannot be read: more careful.
+pub const UNKNOWN_LIGHTS: f32 = 300.0;
+/// Seconds between scans (sim time).
+pub const SCAN_EVERY: f32 = 5.0;
+/// Scans in a row a culprit must be found on before it is removed.
+pub const CONFIRM_SCANS: u8 = 3;
+/// Seconds the cars behind a removed one have to get moving before they count again.
+pub const VERIFY: f32 = 60.0;
+/// Seconds the place of a removal is left alone by the population.
+pub const KEEP_CLEAR: f32 = 120.0;
+/// Standing yielders at one junction count only after this many times the limit.
+pub const YIELD_FACTOR: f32 = 2.0;
+/// Yielders this close (m) are taken to wait on each other.
+pub const YIELD_NEAR: f64 = 40.0;
+/// Progress that resets the clock (m).
+const PROGRESS: f32 = 2.0;
+/// Events kept for the report.
+const LOG_KEEP: usize = 64;
+
+/// How long a car must have stood, from the longest red of the map's lights (`None`: the map
+/// has no lights; `Some(0.0)`: it has lights but their timing could not be read).
+pub fn investigate_after(max_red: Option<f32>) -> f32 {
+    match max_red {
+        None => FLOOR,
+        Some(r) if r <= 0.0 => UNKNOWN_LIGHTS,
+        Some(r) => FLOOR.max(FACTOR * r),
+    }
+}
+
+/// Reasons (`AiCar::why`) that are somebody else's right to hold the car, not a blockage.
+fn legitimate(why: &str) -> bool {
+    matches!(why, "light" | "people" | "service" | "player" | "pull_out")
+}
+
+/// What the scan needs to know of one car.
+#[derive(Debug, Clone)]
+pub struct Snap {
+    pub id: u64,
+    pub odometer: f32,
+    pub speed: f32,
+    pub is_bus: bool,
+    /// Held by a stop of its timetable, the light, or doing something with its own rules
+    /// (overtaking, parking).
+    pub held_legit: bool,
+    pub why: &'static str,
+    pub yielding: bool,
+    /// The car (id) it follows or whose body is in its way.
+    pub lead: Option<u64>,
+    /// The player's vehicle (or a LAN player's) is what is in its way.
+    pub player_block: bool,
+    /// Somebody could see it vanish.
+    pub visible: bool,
+    pub x: f64,
+    pub y: f64,
+    pub lane: usize,
+    pub s: f32,
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+struct Track {
+    odometer: f32,
+    /// Seconds with nothing legitimate holding it and no progress.
+    stuck: f32,
+    /// Seconds it has yielded while standing.
+    yield_stuck: f32,
+    /// Scans in a row it was the culprit.
+    flagged: u8,
+    /// After a removal in front of it: only this long is asked of it.
+    verifying: bool,
+}
+
+#[derive(Debug, Clone)]
+struct Verify {
+    culprit: u64,
+    followers: Vec<u64>,
+    at: f32,
+}
+
+/// What a scan decided.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Action {
+    /// Take this car off the road (nobody sees it); the ids are the cars that stand behind it.
+    Remove { id: u64, followers: Vec<u64>, stood: f32, why: String },
+    /// Something found and left alone (for the log).
+    Note(String),
+}
+
+#[derive(Debug, Default)]
+pub struct Unstick {
+    next_scan: f32,
+    last_scan: f32,
+    tracks: HashMap<u64, Track>,
+    verify: Vec<Verify>,
+    /// Cars removed so far.
+    pub removed: u64,
+    /// Tests: on or off whatever the settings say.
+    pub force: Option<bool>,
+    /// The last decisions, for the report.
+    pub events: std::collections::VecDeque<String>,
+}
+
+impl Unstick {
+    fn note(&mut self, line: String) {
+        log::info!("ai-unstick: {line}");
+        if self.events.len() >= LOG_KEEP {
+            self.events.pop_front();
+        }
+        self.events.push_back(line);
+    }
+
+    /// Is it time to scan at `now`?
+    pub fn due(&mut self, now: f32) -> bool {
+        if now < self.next_scan {
+            return false;
+        }
+        self.next_scan = now + SCAN_EVERY;
+        true
+    }
+
+    /// Forget everything (the feature was switched off, or a new map).
+    pub fn reset(&mut self) {
+        self.tracks.clear();
+        self.verify.clear();
+        self.next_scan = 0.0;
+    }
+
+    /// Go through the snapshots taken at `now`: who is to be taken off. `limit` is
+    /// `investigate_after` for this map.
+    pub fn scan(&mut self, now: f32, limit: f32, snaps: &[Snap]) -> Vec<Action> {
+        let dt = (now - self.last_scan).clamp(0.0, 30.0);
+        self.last_scan = now;
+        let mut actions = Vec::new();
+        let by_id: HashMap<u64, usize> = snaps.iter().enumerate().map(|(i, s)| (s.id, i)).collect();
+        self.tracks.retain(|id, _| by_id.contains_key(id));
+        // 1) the clocks: progress resets, a legitimate hold pauses, the rest counts
+        for s in snaps {
+            let t = self.tracks.entry(s.id).or_insert(Track { odometer: s.odometer, ..Track::default() });
+            if (s.odometer - t.odometer).abs() > PROGRESS || s.speed > 0.5 {
+                *t = Track { odometer: s.odometer, ..Track::default() };
+                continue;
+            }
+            if s.held_legit || legitimate(s.why) || s.player_block {
+                t.flagged = 0;
+                continue;
+            }
+            if s.yielding {
+                t.yield_stuck += dt;
+                continue;
+            }
+            t.stuck += dt;
+        }
+        // 2) the cars to be looked at
+        let need = |t: &Track| if t.verifying { VERIFY.min(limit) } else { limit };
+        let standing: Vec<usize> = (0..snaps.len())
+            .filter(|&i| {
+                let t = &self.tracks[&snaps[i].id];
+                t.stuck >= need(t)
+            })
+            .collect();
+        let yield_standing: Vec<usize> = (0..snaps.len()).filter(|&i| self.tracks[&snaps[i].id].yield_stuck >= YIELD_FACTOR * limit).collect();
+        let in_set: std::collections::HashSet<u64> = standing.iter().map(|&i| snaps[i].id).collect();
+        // 3) who holds whom: follow each one's lead to the end
+        let mut culprits: Vec<(u64, Vec<u64>, String)> = Vec::new();
+        let mut done: std::collections::HashSet<u64> = std::collections::HashSet::new();
+        for &i in &standing {
+            let first = snaps[i].id;
+            if done.contains(&first) {
+                continue;
+            }
+            let mut chain = vec![first];
+            let mut cur = i;
+            let mut circle = false;
+            let mut end_ok = true;
+            for _ in 0..64 {
+                match snaps[cur].lead {
+                    None => break,
+                    Some(l) => match by_id.get(&l) {
+                        None => break,
+                        Some(&j) => {
+                            if chain.contains(&l) {
+                                circle = true;
+                                break;
+                            }
+                            if !in_set.contains(&l) {
+                                // it waits for somebody who moves or has the right to stand
+                                end_ok = false;
+                                break;
+                            }
+                            chain.push(l);
+                            cur = j;
+                        }
+                    },
+                }
+            }
+            for c in &chain {
+                done.insert(*c);
+            }
+            if !end_ok {
+                continue;
+            }
+            if circle {
+                let at = chain.iter().position(|c| Some(*c) == snaps[cur].lead).unwrap_or(0);
+                let members: Vec<u64> = chain[at..].to_vec();
+                // the one that holds the most, then the one that has stood longest, then the lowest id
+                let held_by = |m: u64| chain.iter().filter(|&&c| c != m).count();
+                let pick = members
+                    .iter()
+                    .copied()
+                    .filter(|m| !snaps[by_id[m]].is_bus)
+                    .max_by(|a, b| {
+                        let (ta, tb) = (&self.tracks[a], &self.tracks[b]);
+                        held_by(*a).cmp(&held_by(*b)).then(ta.stuck.partial_cmp(&tb.stuck).unwrap_or(std::cmp::Ordering::Equal)).then(b.cmp(a))
+                    });
+                match pick {
+                    Some(m) => culprits.push((m, chain.iter().copied().filter(|&c| c != m).collect(), format!("circle of {} cars that hold each other", members.len()))),
+                    None => actions.push(Action::Note(format!("circle of buses {members:?}: buses are never removed"))),
+                }
+            } else {
+                let head = *chain.last().unwrap();
+                let hs = &snaps[by_id[&head]];
+                if hs.is_bus {
+                    actions.push(Action::Note(format!("bus {head} heads {} standing cars: buses are never removed", chain.len() - 1)));
+                    continue;
+                }
+                let why = if chain.len() == 1 { "stuck on its own".to_string() } else { format!("head of {} standing cars", chain.len()) };
+                culprits.push((head, chain[..chain.len() - 1].to_vec(), why));
+            }
+        }
+        // (one culprit may head chains found from several of its followers: one entry, all of them behind it)
+        let mut merged: Vec<(u64, Vec<u64>, String)> = Vec::new();
+        for (id, followers, why) in culprits {
+            match merged.iter_mut().find(|m| m.0 == id) {
+                Some(m) => {
+                    for f in followers {
+                        if !m.1.contains(&f) {
+                            m.1.push(f);
+                        }
+                    }
+                    if why.starts_with("head of") || why.starts_with("circle") {
+                        m.2 = why;
+                    }
+                }
+                None => merged.push((id, followers, why)),
+            }
+        }
+        let mut culprits = merged;
+        // yielding cars that wait on each other at one junction (no lead to follow)
+        let yielders: Vec<usize> = yield_standing.iter().copied().filter(|&i| !snaps[i].is_bus && !culprits.iter().any(|c| c.0 == snaps[i].id || c.1.contains(&snaps[i].id))).collect();
+        for &i in &yielders {
+            let a = &snaps[i];
+            let near: Vec<u64> = yielders.iter().filter(|&&j| j != i && ((snaps[j].x - a.x).powi(2) + (snaps[j].y - a.y).powi(2)).sqrt() < YIELD_NEAR).map(|&j| snaps[j].id).collect();
+            if near.is_empty() {
+                continue;
+            }
+            // one of the standing yielders goes: the one that has waited longest
+            let longest = std::iter::once(a.id).chain(near.iter().copied()).max_by(|x, y| self.tracks[x].yield_stuck.partial_cmp(&self.tracks[y].yield_stuck).unwrap_or(std::cmp::Ordering::Equal).then(y.cmp(x)));
+            if longest == Some(a.id) {
+                culprits.push((a.id, near, "yielders at one junction that wait on each other".to_string()));
+            }
+        }
+        // 4) confirm, and only then decide; those not found this time start over
+        let found: std::collections::HashSet<u64> = culprits.iter().map(|c| c.0).collect();
+        for (id, t) in self.tracks.iter_mut() {
+            if !found.contains(id) {
+                t.flagged = 0;
+            }
+        }
+        for (id, followers, why) in culprits {
+            let s = &snaps[by_id[&id]];
+            let t = self.tracks.get_mut(&id).unwrap();
+            t.flagged = t.flagged.saturating_add(1);
+            if t.flagged < CONFIRM_SCANS {
+                continue;
+            }
+            if s.visible {
+                if t.flagged == CONFIRM_SCANS {
+                    actions.push(Action::Note(format!("car {id} ({why}) is still in sight: left alone until nobody can see it go")));
+                }
+                continue;
+            }
+            let stood = t.stuck.max(t.yield_stuck);
+            actions.push(Action::Remove { id, followers, stood, why });
+        }
+        // 5) what became of the cars behind earlier removals
+        let mut still = Vec::new();
+        for v in std::mem::take(&mut self.verify) {
+            if now - v.at < VERIFY {
+                still.push(v);
+                continue;
+            }
+            let stuck: Vec<u64> = v.followers.iter().copied().filter(|f| self.tracks.get(f).is_some_and(|t| t.stuck >= VERIFY.min(limit))).collect();
+            let moving = v.followers.iter().filter(|f| by_id.contains_key(*f)).count().saturating_sub(stuck.len());
+            if stuck.is_empty() {
+                self.note(format!("after taking car {} off, the {} cars behind it are moving again", v.culprit, moving));
+            } else {
+                self.note(format!("after taking car {} off, cars {stuck:?} still stand: the next culprit is looked for", v.culprit));
+            }
+        }
+        self.verify = still;
+        actions
+    }
+
+    /// Record a removal that was carried out: the followers get `VERIFY` seconds.
+    pub fn removed_one(&mut self, now: f32, id: u64, followers: Vec<u64>, stood: f32, why: &str) {
+        self.removed += 1;
+        self.tracks.remove(&id);
+        for f in &followers {
+            if let Some(t) = self.tracks.get_mut(f) {
+                *t = Track { odometer: t.odometer, verifying: true, ..Track::default() };
+            }
+        }
+        self.note(format!("took car {id} off ({why}; no progress for {stood:.0} s, {} cars behind it)", followers.len()));
+        self.verify.push(Verify { culprit: id, followers, at: now });
+    }
+}
+
+impl TrafficSim {
+    /// The longest red any light of the map shows (None: there are no lights).
+    pub fn longest_red(&self) -> Option<f32> {
+        if self.lights.is_empty() {
+            return None;
+        }
+        Some(self.lights.iter().map(|c| c.max_red()).fold(0.0f32, f32::max))
+    }
+
+    /// One look at the cars, now and then (called at the end of every traffic step).
+    pub fn unstick_step(&mut self) {
+        if !self.unstick.force.unwrap_or_else(|| omsi_cfg::addon_switch::enabled("ai_unstick")) {
+            if !self.unstick.tracks.is_empty() {
+                self.unstick.reset();
+            }
+            return;
+        }
+        let now = self.time;
+        if !self.unstick.due(now) {
+            return;
+        }
+        let ids: std::collections::HashSet<u64> = self.cars.iter().map(|c| c.id).collect();
+        let snaps: Vec<Snap> = self
+            .cars
+            .iter()
+            .map(|c| {
+                let body = c.geo_block.filter(|g| ids.contains(g));
+                let player_block = c.why.0 == "player" || c.geo_block.is_some_and(|g| !ids.contains(&g));
+                let p = c.vehicle.position;
+                let r = (c.state.front + c.state.rear).abs().max(4.0) as f64 + 2.0;
+                Snap {
+                    id: c.id,
+                    odometer: c.state.odometer,
+                    speed: c.state.speed.abs(),
+                    is_bus: c.is_bus(),
+                    held_legit: c.light_hold || c.at_stop() || c.passing.is_some() || c.park.is_some() || c.fresh > 0.0,
+                    why: c.why.0,
+                    yielding: c.yielding,
+                    lead: c.lead_car.or(body),
+                    player_block,
+                    visible: !self.unseen(p, r, |_| false),
+                    x: p.x,
+                    y: p.y,
+                    lane: c.state.lane,
+                    s: c.state.s,
+                }
+            })
+            .collect();
+        let limit = investigate_after(self.longest_red());
+        let actions = self.unstick.scan(now, limit, &snaps);
+        for a in actions {
+            match a {
+                Action::Note(n) => self.unstick.note(n),
+                Action::Remove { id, followers, stood, why } => {
+                    let place = snaps.iter().find(|s| s.id == id).map(|s| (s.lane, s.s));
+                    if self.take_off_id(id, Removal::Finished).is_some() {
+                        self.retired.push(id);
+                        if let Some((lane, s)) = place {
+                            self.admission.keep_clear(lane, s, now, KEEP_CLEAR);
+                        }
+                        self.unstick.removed_one(now, id, followers, stood, &why);
+                    }
+                }
+            }
+        }
+    }
+}

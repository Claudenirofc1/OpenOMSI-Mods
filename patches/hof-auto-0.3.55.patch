diff --git a/crates/omsi-app/src/game_panels/dashcam_panel.rs b/crates/omsi-app/src/game_panels/dashcam_panel.rs
new file mode 100644
index 00000000..10a03d4b
--- /dev/null
+++ b/crates/omsi-app/src/game_panels/dashcam_panel.rs
@@ -0,0 +1,103 @@
+//! The dashcam's panel (Alt, the "Dashcam" tile; buttons of the controls too): put the camera
+//! where the view is now (it is then fixed to the bus like an installed camera), see where it
+//! looks, its field of view, the security-camera look and its name, and start or stop the
+//! recording. It changes the same state the Ctrl+J keys do (`dashcam`), kept in `dashcam.cfg`.
+
+use super::{button, card, divider, el, grow_row, input, note, slider_row, text, title};
+use omsi_plugin::api::Value;
+use omsi_plugin::ui::{Anchor, Element, Kind, Panel, Weight};
+use omsi_ui::theme::Palette;
+use omsi_ui::tr;
+
+const FOV: (f32, f32) = (30.0, 110.0);
+
+#[derive(Default)]
+pub(crate) struct DashcamPanel {
+    said: Option<String>,
+}
+
+fn check(id: &str, label: &str, on: bool) -> Element {
+    el(Some(id), Kind::Checkbox { text: label.to_string(), checked: on })
+}
+
+impl DashcamPanel {
+    pub(crate) fn panel(&self, app: &mut crate::App, pal: Palette) -> Panel {
+        let snap = app.player.as_ref().map(|p| app.gfx.dashcam.snapshot(p));
+        let mut c = vec![title(&tr("Dashcam"))];
+        let Some(s) = snap else {
+            c.push(note(&tr("Get into a bus first: the camera belongs to the bus."), pal));
+            c.push(button("close", &tr("Close"), Some("close")));
+            return card(Anchor::Center, 0.0, 0.0, 460.0, 235, pal, c);
+        };
+        if !omsi_cfg::addon_switch::enabled("dashcam") {
+            c.push(note(&tr("The dashcam is switched off (Mods in the launcher)."), pal));
+        }
+        c.push(note(&tr("Look where you want the camera (the free camera too) and press Place. It stays fixed to the bus."), pal));
+        c.push(el(None, Kind::Text { text: format!("{}: {}", tr("Looks at"), s.focus), size: 14.0, weight: Weight::Bold, align: omsi_plugin::ui::Align::Left, wrap: true }));
+        c.push(grow_row(vec![
+            button("place", &tr("Place the camera here"), Some("my_location")),
+            button("unplace", &tr("Back to the driver's view"), Some("undo")),
+        ]));
+        c.push(slider_row("fov", &tr("Field of view"), &format!("{:.0}°", s.cfg.fov), s.cfg.fov, FOV, 1.0));
+        c.push(check("cctv", &tr("Security camera look (name and clock on the picture)"), s.cfg.cctv));
+        c.push(grow_row(vec![text(&tr("Name on the picture"), 13.0, Weight::Regular), input("name", &s.cfg.name, "CAM 1", 24)]));
+        c.push(divider());
+        if s.recording {
+            c.push(el(None, Kind::Text { text: format!("● REC {}:{:02}", s.secs / 60, s.secs % 60), size: 16.0, weight: Weight::Bold, align: omsi_plugin::ui::Align::Left, wrap: false }));
+        } else if s.waiting {
+            c.push(note(&tr("Starting..."), pal));
+        }
+        if let Some(f) = &s.file {
+            c.push(note(f, pal));
+        }
+        if !s.ffmpeg {
+            c.push(note(&tr("ffmpeg was not found: put ffmpeg.exe beside the game or in .openomsi\\bin."), pal));
+        }
+        let rec = if s.recording || s.waiting { tr("Stop recording") } else { tr("Start recording") };
+        c.push(grow_row(vec![button("record", &rec, Some(if s.recording || s.waiting { "stop" } else { "videocam" })), button("close", &tr("Close"), Some("close"))]));
+        c.push(note(&format!("{}: {}", tr("Videos go to"), s.folder), pal));
+        if let Some(said) = &self.said {
+            c.push(note(said, pal));
+        }
+        card(Anchor::Center, 0.0, 0.0, 460.0, 235, pal, c)
+    }
+}
+
+pub(crate) fn open(app: &mut crate::App) {
+    app.menus.game_panels.dashcam = Some(DashcamPanel::default());
+}
+
+pub(crate) fn click(app: &mut crate::App, id: &str) {
+    if id == "close" {
+        app.menus.game_panels.dashcam = None;
+        return;
+    }
+    let eye = app.camera.as_ref().map(|c| (c.position, c.forward(), c.fov_deg));
+    let Some(p) = app.player.as_ref() else { return };
+    let said = match id {
+        "place" => Some(match eye {
+            Some((pos, fwd, fov)) => app.gfx.dashcam.register(p, pos, fwd, fov),
+            None => tr("No camera to place the dashcam").into_owned(),
+        }),
+        "unplace" => {
+            app.gfx.dashcam.unplace(p);
+            Some(tr("The dashcam records the driver's own view again.").into_owned())
+        }
+        "record" if omsi_cfg::addon_switch::enabled("dashcam") => Some(app.gfx.dashcam.toggle(p)),
+        "record" => Some(tr("The dashcam is switched off (Mods in the launcher).").into_owned()),
+        _ => return,
+    };
+    if let Some(d) = app.menus.game_panels.dashcam.as_mut() {
+        d.said = said;
+    }
+}
+
+pub(crate) fn change(app: &mut crate::App, id: &str, value: &Value) {
+    let Some(p) = app.player.as_ref() else { return };
+    match (id, value) {
+        ("fov", Value::Num(v)) => app.gfx.dashcam.set_fov(p, *v as f32),
+        ("cctv", Value::Bool(b)) => app.gfx.dashcam.set_look(p, *b),
+        ("name", Value::Str(s)) => app.gfx.dashcam.set_name(p, s),
+        _ => {}
+    }
+}
diff --git a/crates/omsi-app/src/game_panels/door_cams_panel.rs b/crates/omsi-app/src/game_panels/door_cams_panel.rs
new file mode 100644
index 00000000..d4af990f
--- /dev/null
+++ b/crates/omsi-app/src/game_panels/door_cams_panel.rs
@@ -0,0 +1,156 @@
+//! The door cameras' panel (Alt, the "Door cameras" tile; a button of the controls too): the
+//! switch, the "any door" trigger and each camera of the bus - which doors open it, its field of
+//! view, the picture turned over, where it looks (put where the view is now) - and a button to
+//! register a new camera where the view is. It changes the same state the Ctrl+K keys do
+//! (`door_cams`), so the two always agree, and what is set is kept in `door_cams.cfg` at once.
+
+use super::{button, card, divider, el, grow_row, note, row, slider_row, text, title};
+use omsi_plugin::api::Value;
+use omsi_plugin::ui::{Anchor, Element, Kind, Panel, RowAlign, Weight};
+use omsi_ui::theme::Palette;
+use omsi_ui::tr;
+
+const FOV: (f32, f32) = (30.0, 110.0);
+
+#[derive(Default)]
+pub(crate) struct DoorCamsPanel {
+    said: Option<String>,
+}
+
+fn check(id: &str, label: &str, on: bool) -> Element {
+    el(Some(id), Kind::Checkbox { text: label.to_string(), checked: on })
+}
+
+impl DoorCamsPanel {
+    pub(crate) fn panel(&self, app: &mut crate::App, pal: Palette) -> Panel {
+        let snap = match app.player.as_ref() {
+            Some(p) => Some(app.gfx.door_cams.snapshot(p)),
+            None => None,
+        };
+        let mut c = vec![title(&tr("Door cameras"))];
+        let Some(s) = snap else {
+            c.push(note(&tr("Get into a bus first: the cameras belong to the bus."), pal));
+            c.push(button("close", &tr("Close"), Some("close")));
+            return card(Anchor::Center, 0.0, 0.0, 460.0, 235, pal, c);
+        };
+        if !omsi_cfg::addon_switch::enabled("door_cams") {
+            c.push(note(&tr("The door cameras are switched off (Mods in the launcher)."), pal));
+        }
+        c.push(note(&tr("A camera's picture pops up while one of its doors is open. Cameras are kept for this bus."), pal));
+        c.push(grow_row(vec![
+            check("on", &tr("Door cameras on"), s.enabled),
+            check("all", &tr("Any door shows every camera"), s.all_doors),
+        ]));
+        c.push(divider());
+        if s.cams.is_empty() {
+            c.push(note(&tr("No camera yet: look where you want it (the free camera too) and press Add."), pal));
+        }
+        for (i, cam) in s.cams.iter().enumerate() {
+            c.push(row(
+                vec![
+                    Element { grow: true, ..text(&cam.name, 14.0, Weight::Bold) },
+                    button(&format!("c{i}aim"), &tr("Look here"), Some("my_location")),
+                    button(&format!("c{i}del"), &tr("Remove"), Some("delete")),
+                ],
+                RowAlign::Start,
+            ));
+            let doors: Vec<Element> = (1..=s.doors).map(|n| check(&format!("c{i}d{n}"), &format!("{} {n}", tr("Door")), cam.doors.contains(&n))).collect();
+            c.push(row(doors, RowAlign::Start));
+            c.push(slider_row(&format!("c{i}fov"), &tr("Field of view"), &format!("{:.0}°", cam.fov), cam.fov, FOV, 1.0));
+            c.push(check(&format!("c{i}flip"), &tr("Mirror image (left / right)"), cam.flip_x));
+            c.push(divider());
+        }
+        c.push(grow_row(vec![
+            button("add", &tr("Add a camera here"), Some("photo_camera")),
+            button("close", &tr("Close"), Some("close")),
+        ]));
+        if let Some(said) = &self.said {
+            c.push(note(said, pal));
+        }
+        card(Anchor::Center, 0.0, 0.0, 460.0, 235, pal, c)
+    }
+}
+
+pub(crate) fn open(app: &mut crate::App) {
+    app.menus.game_panels.door_cams = Some(DoorCamsPanel::default());
+}
+
+/// "c<i>d<n>", "c<i>fov", ...: the camera and what is asked of it.
+fn cam_id(id: &str) -> Option<(usize, &str)> {
+    let rest = id.strip_prefix('c')?;
+    let at = rest.find(|ch: char| !ch.is_ascii_digit())?;
+    Some((rest[..at].parse().ok()?, &rest[at..]))
+}
+
+pub(crate) fn click(app: &mut crate::App, id: &str) {
+    let eye = app.camera.as_ref().map(|c| (c.position, c.forward(), c.fov_deg));
+    let said = match id {
+        "close" => {
+            app.menus.game_panels.door_cams = None;
+            return;
+        }
+        "add" => {
+            let Some(p) = app.player.as_ref() else { return };
+            match eye {
+                Some((pos, fwd, fov)) => Some(app.gfx.door_cams.register(p, pos, fwd, fov)),
+                None => Some(tr("No camera to register").into_owned()),
+            }
+        }
+        _ => {
+            let Some((i, what)) = cam_id(id) else { return };
+            let Some(p) = app.player.as_ref() else { return };
+            match what {
+                "del" => {
+                    app.gfx.door_cams.remove_at(p, i);
+                    None
+                }
+                "aim" => {
+                    if let Some((pos, fwd, fov)) = eye {
+                        app.gfx.door_cams.aim_at(p, i, pos, fwd, fov);
+                    }
+                    Some(tr("The camera now looks where your view does.").into_owned())
+                }
+                _ => return,
+            }
+        }
+    };
+    if let Some(d) = app.menus.game_panels.door_cams.as_mut() {
+        d.said = said;
+    }
+}
+
+pub(crate) fn change(app: &mut crate::App, id: &str, value: &Value) {
+    let Some(p) = app.player.as_ref() else { return };
+    match (id, value) {
+        ("on", Value::Bool(b)) => app.gfx.door_cams.set_enabled(p, *b),
+        ("all", Value::Bool(b)) => app.gfx.door_cams.set_all(p, *b),
+        _ => {
+            let Some((i, what)) = cam_id(id) else { return };
+            match (what, value) {
+                ("fov", Value::Num(v)) => app.gfx.door_cams.set_fov(p, i, *v as f32),
+                ("flip", Value::Bool(b)) => app.gfx.door_cams.set_flip(p, i, *b),
+                (d, Value::Bool(b)) => {
+                    if let Some(n) = d.strip_prefix('d').and_then(|n| n.parse().ok()) {
+                        app.gfx.door_cams.set_door(p, i, n, *b);
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::cam_id;
+
+    #[test]
+    fn a_cameras_element_names_its_camera_and_what_it_is() {
+        assert_eq!(cam_id("c0d2"), Some((0, "d2")));
+        assert_eq!(cam_id("c12fov"), Some((12, "fov")));
+        assert_eq!(cam_id("c3flip"), Some((3, "flip")));
+        assert_eq!(cam_id("close"), None);
+        assert_eq!(cam_id("c"), None);
+        assert_eq!(cam_id("cxd1"), None);
+    }
+}

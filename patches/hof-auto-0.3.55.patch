+    /// The longest stretch any light of this program stays red (red or red and yellow), in
+    /// seconds, round the cycle (a stop point that holds the clock can make it longer: not
+    /// counted). 0 for a program with no red.
+    pub fn max_red(&self) -> f32 {
+        let cycle = self.cycle_len();
+        let step = 0.25;
+        let n = (cycle / step).ceil().max(1.0) as usize;
+        let mut best = 0.0f32;
+        for i in 0..self.lights.len() {
+            let red: Vec<bool> = (0..n).map(|k| matches!(Self::aspect(self.state_at(i, k as f64 * step)), Aspect::Red | Aspect::RedYellow)).collect();
+            if red.iter().all(|&r| r) {
+                // red for ever within the cycle: the whole cycle
+                best = best.max(cycle as f32);
+                continue;
+            }
+            // longest run of red going round (start just after a non-red step)
+            let start = red.iter().position(|&r| !r).unwrap_or(0);
+            let mut run = 0usize;
+            for k in 1..=n {
+                if red[(start + k) % n] {
+                    run += 1;
+                    best = best.max(run as f32 * step as f32);
+                } else {
+                    run = 0;
+                }
+            }
+        }
+        best
+    }

new file mode 100644
index 00000000..e85f77c7
--- /dev/null
+++ b/crates/omsi-app/src/door_cams.rs
@@ -0,0 +1,494 @@
+//! Door cameras (openOMSI HOF-Auto add-on): cameras the player puts on a bus, shown in a popup
+//! while the doors they watch are open - the rear door's view for the driver who is watching
+//! the mirror, say.
+//!
+//! * The cameras are the engine's own fixed (CCTV) cameras, `[add_camera_reflexion_static]`:
+//!   they are added to the bus's list of reflection cameras for the frame
+//!   (`extra_cameras`, read by `render_mirrors`), so they are drawn like any mirror.
+//! * Registered per bus in `door_cams.cfg` next to the settings (plain text, one line each:
+//!   `<bus path>|cam=name;x,y,z;yaw;pitch;fov;doors;flip`, and `<bus path>|all=1` and `|on=0`).
+//!   `doors` are the numbers of Shift+1..9 (1 = the first door from the front), so a bus with
+//!   2+2 or 3+2 doors needs nothing special.
+//! * The popup shows every camera of the bus, side by side in the order they were registered,
+//!   while any door that has a camera is open; one door closing or opening changes nothing
+//!   until the last one closes. With the "all doors" trigger on, any door opening shows it.
+//!
+//! Keys (Ctrl+K family, none of them bound by OMSI): Ctrl+K on/off, Ctrl+Shift+K registers a
+//! camera where the view is now (in the free camera too), Ctrl+Shift+1..9 puts the door on or
+//! off the last camera, Ctrl+Alt+K removes the last camera, Ctrl+Alt+Shift+K the "all doors"
+//! trigger.
+
+use crate::player::Player;
+use crate::scene::World;
+use glam::{DVec3, Mat4, Vec3};
+use omsi_render::Scene;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+pub(crate) use omsi_cfg::door_cams_file::DoorCam;
+
+/// What the Alt menu's panel shows: the switches, the cameras and how many doors the bus has.
+pub(crate) struct Snapshot {
+    pub enabled: bool,
+    pub all_doors: bool,
+    pub cams: Vec<DoorCam>,
+    pub doors: usize,
+}
+
+/// Seconds between two looks at the doors.
+const POLL: f32 = 0.2;
+/// The popup's pictures: their height as a part of the window's, the gap between two (a part
+/// of the window's width), and their width over height - the mirrors are drawn at 1.6:1 into
+/// a square texture (`camera_util::MIRROR_ASPECT`), so shown 1.6 times as wide as they are high
+/// they come out as the camera sees them.
+const HEIGHT: f32 = 0.22;
+const GAP: f32 = 0.008;
+pub(crate) const ASPECT: f32 = 1.6;
+
+#[derive(Default)]
+pub(crate) struct DoorCams {
+    /// The bus the cameras belong to (its `.bus` path, lower case).
+    key: String,
+    pub cams: Vec<DoorCam>,
+    /// The feature is on (Ctrl+K).
+    pub enabled: bool,
+    /// Any door opening shows the popup, whether it has a camera or not.
+    pub all_doors: bool,
+    /// Which doors were open at the last look (index = door number - 1).
+    open: Vec<bool>,
+    last_poll: Option<Instant>,
+    /// The popup is on the screen.
+    visible: bool,
+    /// The cameras (by place in the list) the popup shows now: those of the doors that are open.
+    shown: Vec<usize>,
+}
+
+/// What the renderer reads: the cameras of the bus being shown now, only while the popup is up.
+static EXTRA: OnceLock<Mutex<(String, Vec<omsi_vehicle::Camera>)>> = OnceLock::new();
+
+fn extra() -> &'static Mutex<(String, Vec<omsi_vehicle::Camera>)> {
+    EXTRA.get_or_init(|| Mutex::new((String::new(), Vec::new())))
+}
+
+/// The cameras to add after a bus's own (and its rear sections') reflection cameras, for the
+/// bus at `path`; none while the popup is down.
+pub(crate) fn extra_cameras(path: &str) -> Vec<omsi_vehicle::Camera> {
+    let g = extra().lock().unwrap_or_else(|e| e.into_inner());
+    if g.0.eq_ignore_ascii_case(path) { g.1.clone() } else { Vec::new() }
+}
+
+/// The cameras the popup shows: those with an open door; with `all_doors`, any open door shows every camera.
+pub(crate) fn shown_cameras(cams: &[DoorCam], open: &[bool], all_doors: bool) -> Vec<usize> {
+    if all_doors && open.iter().any(|o| *o) {
+        return (0..cams.len()).collect();
+    }
+    let is_open = |d: &usize| *d >= 1 && open.get(*d - 1).copied().unwrap_or(false);
+    cams.iter().enumerate().filter(|(_, c)| c.doors.iter().any(is_open)).map(|(i, _)| i).collect()
+}
+
+/// The popup is to be shown: any camera has an open door (or any door is, with `all_doors`).
+pub(crate) fn popup_visible(cams: &[DoorCam], open: &[bool], all_doors: bool) -> bool {
+    !shown_cameras(cams, open, all_doors).is_empty()
+}
+
+/// Where the pictures go in a window of `w` x `h`: side by side in order, centred at the
+/// bottom; made smaller when they would not fit across.
+pub(crate) fn layout(n: usize, w: f32, h: f32) -> Vec<[f32; 4]> {
+    if n == 0 || w <= 0.0 || h <= 0.0 {
+        return Vec::new();
+    }
+    let mut high = HEIGHT * h;
+    let gap = GAP * w;
+    let room = 0.92 * w;
+    let total = |hh: f32| n as f32 * hh * ASPECT + (n as f32 - 1.0) * gap;
+    if total(high) > room {
+        high = (room - (n as f32 - 1.0) * gap) / (n as f32 * ASPECT);
+    }
+    let wide = high * ASPECT;
+    let left = (w - total(high)) / 2.0;
+    let top = h - high - 0.04 * h;
+    (0..n).map(|i| {
+        let x = left + i as f32 * (wide + gap);
+        [x, top, x + wide, top + high]
+    }).collect()
+}
+
+/// A world view (position, forward direction) in the bus's own frame: the position, yaw and
+/// pitch (degrees) a camera of the bus needs to see the same.
+pub(crate) fn to_bus_frame(bus_pos: DVec3, bus_rot: Mat4, eye: DVec3, forward: Vec3) -> ([f32; 3], f32, f32) {
+    let inv = bus_rot.inverse();
+    let p = inv.transform_point3((eye - bus_pos).as_vec3());
+    let f = inv.transform_vector3(forward).normalize_or(Vec3::Y);
+    ([p.x, p.y, p.z], f.x.atan2(f.y).to_degrees(), f.z.clamp(-1.0, 1.0).asin().to_degrees())
+}
+
+fn path_of(p: &Player) -> String {
+    p.vehicle.ty.def.path.to_string_lossy().into_owned()
+}
+
+/// How many reflection cameras the bus and its rear sections have: where ours start.
+pub(crate) fn first_index(p: &Player) -> usize {
+    p.vehicle.ty.def.cameras_reflexion.len() + p.vehicle.trailers.iter().map(|t| t.ty.def.cameras_reflexion.len()).sum::<usize>()
+}
+
+impl DoorCams {
+    /// Load the bus's cameras when the bus changes.
+    fn sync(&mut self, p: &Player) {
+        let path = path_of(p);
+        let key = path.to_ascii_lowercase();
+        if self.key == key {
+            return;
+        }
+        self.key = key;
+        self.open.clear();
+        self.visible = false;
+        let (enabled, all, cams) = load(&path);
+        self.enabled = enabled;
+        self.all_doors = all;
+        self.cams = cams;
+    }
+
+    /// Once a frame, before the mirrors are drawn: look at the doors a few times a second, work
+    /// out whether the popup is up and hand the cameras to the renderer while it is. The
+    /// cameras' numbers (in the order of the mirror pictures) are put into `idx`.
+    pub fn update(&mut self, p: &mut Player, show: bool, idx: &mut Vec<usize>) {
+        idx.clear();
+        if !omsi_cfg::addon_switch::enabled("door_cams") {
+            self.visible = false;
+            let mut g = extra().lock().unwrap_or_else(|e| e.into_inner());
+            g.0.clear();
+            g.1.clear();
+            return;
+        }
+        self.sync(p);
+        let due = self.last_poll.is_none_or(|t| t.elapsed().as_secs_f32() >= POLL);
+        if due && self.enabled && !self.cams.is_empty() {
+            self.last_poll = Some(Instant::now());
+            self.open = doors_open(p);
+            self.shown = shown_cameras(&self.cams, &self.open, self.all_doors);
+            self.visible = !self.shown.is_empty();
+        }
+        let on = show && self.enabled && self.visible && !self.cams.is_empty();
+        let mut g = extra().lock().unwrap_or_else(|e| e.into_inner());
+        if on {
+            g.0 = path_of(p);
+            g.1 = self.shown.iter().filter_map(|i| self.cams.get(*i)).map(bus_camera).collect();
+            let base = first_index(p);
+            idx.extend(base..base + g.1.len());
+        } else {
+            g.0.clear();
+            g.1.clear();
+        }
+    }
+
+    /// Put the popup's pictures into the frame's overlays (`viewport` = the HUD's rectangle).
+    pub fn push(&self, scene: &mut Scene, world: &World, first: usize, viewport: [f32; 4]) {
+        if !(self.enabled && self.visible) {
+            return;
+        }
+        let start = scene.overlays.len();
+        let textures = world.mirror_textures.lock();
+        for (k, r) in layout(self.shown.len(), viewport[2], viewport[3]).into_iter().enumerate() {
+            let Some(tex) = textures.get(first + k).copied().flatten() else { continue };
+            let Some(c) = self.shown.get(k).and_then(|i| self.cams.get(*i)) else { continue };
+            let (x0, x1) = if c.flip_x { (r[2], r[0]) } else { (r[0], r[2]) };
+            let (y0, y1) = if c.flip_y { (r[3], r[1]) } else { (r[1], r[3]) };
+            scene.transposed.remove(&tex);
+            scene.overlays.push((tex, [x0, y0, x1, y1]));
+        }
+        drop(textures);
+        scene.shift_overlays(start, viewport[0]);
+    }
+
+    /// Ctrl+K: the cameras on or off.
+    pub fn toggle(&mut self, p: &Player) -> String {
+        self.sync(p);
+        self.enabled = !self.enabled;
+        self.visible = false;
+        self.save();
+        if self.enabled {
+            format!("Door cameras on ({} registered; Ctrl+Shift+K adds one where the view is)", self.cams.len())
+        } else {
+            "Door cameras off (Ctrl+K)".into()
+        }
+    }
+
+    /// Ctrl+Alt+Shift+K: any door opening shows the popup.
+    pub fn toggle_all(&mut self, p: &Player) -> String {
+        self.sync(p);
+        self.all_doors = !self.all_doors;
+        self.save();
+        if self.all_doors { "Door cameras: every door shows the popup".into() } else { "Door cameras: only the doors set for the cameras show the popup".into() }
+    }
+
+    /// Ctrl+Shift+K: a camera where `eye` looks along `forward` (the free camera's, or any
+    /// view's), for the next door that has none yet.
+    pub fn register(&mut self, p: &Player, eye: DVec3, forward: Vec3, fov: f32) -> String {
+        self.sync(p);
+        let (pos, yaw, pitch) = to_bus_frame(p.vehicle.position, p.vehicle.body_rotation(), eye, forward);
+        let doors = crate::player::door_keys(&p.vehicle.ty).len().max(1);
+        let n = self.cams.len() + 1;
+        let door = n.min(doors);
+        self.cams.push(DoorCam {
+            name: format!("Door {n}"),
+            pos,
+            yaw,
+            pitch,
+            fov: if fov > 10.0 { fov.clamp(30.0, 110.0) } else { 70.0 },
+            doors: vec![door],
+            flip_x: false,
+            flip_y: false,
+        });
+        self.enabled = true;
+        self.save();
+        format!("Door camera {n} registered on door {door} ({:.1}, {:.1}, {:.1} m); Ctrl+Shift+1..9 changes its doors", pos[0], pos[1], pos[2])
+    }
+
+    /// Ctrl+Shift+1..9: door `n` on or off the last camera registered.
+    pub fn toggle_door(&mut self, p: &Player, n: usize) -> String {
+        self.sync(p);
+        let Some(c) = self.cams.last_mut() else { return "No door camera yet (Ctrl+Shift+K registers one)".into() };
+        match c.doors.iter().position(|d| *d == n) {
+            Some(i) => {
+                c.doors.remove(i);
+            }
+            None => {
+                c.doors.push(n);
+                c.doors.sort_unstable();
+            }
+        }
+        let list: Vec<String> = c.doors.iter().map(|d| d.to_string()).collect();
+        let msg = format!("{}: doors {}", c.name, if list.is_empty() { "none".into() } else { list.join(", ") });
+        self.save();
+        msg
+    }
+
+    /// Ctrl+Alt+K: the last camera registered goes.
+    pub fn remove_last(&mut self, p: &Player) -> String {
+        self.sync(p);
+        match self.cams.pop() {
+            Some(c) => {
+                self.visible = false;
+                self.save();
+                format!("{} removed", c.name)
+            }
+            None => "No door camera to remove".into(),
+        }
+    }
+
+    fn save(&self) {
+        store(&self.key, self.enabled, self.all_doors, &self.cams);
+    }
+
+    // --- the Alt menu's panel (`game_panels::door_cams_panel`): the same state the keys change ---
+
+    /// What the panel shows for the bus: the cameras are loaded first.
+    pub fn snapshot(&mut self, p: &Player) -> Snapshot {
+        self.sync(p);
+        Snapshot { enabled: self.enabled, all_doors: self.all_doors, cams: self.cams.clone(), doors: crate::player::door_keys(&p.vehicle.ty).len().clamp(1, 9) }
+    }
+
+    pub fn set_enabled(&mut self, p: &Player, on: bool) {
+        self.sync(p);
+        self.enabled = on;
+        self.visible = false;
+        self.save();
+    }
+
+    pub fn set_all(&mut self, p: &Player, on: bool) {
+        self.sync(p);
+        self.all_doors = on;
+        self.save();
+    }
+
+    /// Door `n` (1 = the first from the front) on or off camera `i`.
+    pub fn set_door(&mut self, p: &Player, i: usize, n: usize, on: bool) {
+        self.sync(p);
+        if let Some(c) = self.cams.get_mut(i) {
+            c.doors.retain(|d| *d != n);
+            if on {
+                c.doors.push(n);
+                c.doors.sort_unstable();
+            }
+            self.save();
+        }
+    }
+
+    pub fn set_flip(&mut self, p: &Player, i: usize, on: bool) {
+        self.sync(p);
+        if let Some(c) = self.cams.get_mut(i) {
+            c.flip_x = on;
+            self.save();
+        }
+    }
+
+    pub fn set_fov(&mut self, p: &Player, i: usize, fov: f32) {
+        self.sync(p);
+        if let Some(c) = self.cams.get_mut(i) {
+            c.fov = fov.clamp(30.0, 110.0);
+            self.save();
+        }
+    }
+
+    pub fn remove_at(&mut self, p: &Player, i: usize) {
+        self.sync(p);
+        if i < self.cams.len() {
+            self.cams.remove(i);
+            self.visible = false;
+            self.save();
+        }
+    }
+
+    /// Camera `i` moved to where `eye` looks along `forward` now.
+    pub fn aim_at(&mut self, p: &Player, i: usize, eye: DVec3, forward: Vec3, fov: f32) {
+        self.sync(p);
+        let (pos, yaw, pitch) = to_bus_frame(p.vehicle.position, p.vehicle.body_rotation(), eye, forward);
+        if let Some(c) = self.cams.get_mut(i) {
+            c.pos = pos;
+            c.yaw = yaw;
+            c.pitch = pitch;
+            if fov > 10.0 {
+                c.fov = fov.clamp(30.0, 110.0);
+            }
+            self.save();
+        }
+    }
+}
+
+fn bus_camera(c: &DoorCam) -> omsi_vehicle::Camera {
+    omsi_vehicle::Camera { pos: c.pos, dist: 0.0, fov: c.fov, yaw: c.yaw, pitch: c.pitch, extra: None, fixed: true }
+}
+
+/// Which doors are open now, in the order of the door keys (Shift+1 first).
+fn doors_open(p: &mut Player) -> Vec<bool> {
+    use crate::player::{door_trigger_open, trigger_leaves};
+    let groups = crate::player::door_keys(&p.vehicle.ty);
+    let v = &mut p.vehicle;
+    groups
+        .iter()
+        .map(|g| {
+            if g.len() == 1 && g[0] == "bus_dooraft" {
+                return false;
+            }
+            g.iter().any(|t| match t.split_once('|') {
+                Some((open, _)) => trigger_leaves(&v.ty.program, open).iter().any(|l| v.var(l).is_some_and(|x| x > 0.5)),
+                None => door_trigger_open(v, t) == Some(true),
+            })
+        })
+        .collect()
+}
+
+fn file() -> Option<std::path::PathBuf> {
+    omsi_cfg::door_cams_file::file()
+}
+
+/// (on, all doors, cameras) of the bus at `path`.
+fn load(path: &str) -> (bool, bool, Vec<DoorCam>) {
+    let Some(f) = file() else { return (true, false, Vec::new()) };
+    let b = omsi_cfg::door_cams_file::load_from(&f, path);
+    (b.on, b.all_doors, b.cams)
+}
+
+fn store(key: &str, on: bool, all: bool, cams: &[DoorCam]) {
+    let Some(f) = file() else { return };
+    let _ = omsi_cfg::door_cams_file::store_to(&f, key, &omsi_cfg::door_cams_file::BusCams { on, all_doors: all, cams: cams.to_vec() });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use omsi_cfg::door_cams_file::{format_cam, parse_cam};
+
+    fn cam(doors: &[usize]) -> DoorCam {
+        DoorCam { name: "c".into(), pos: [1.0, -4.0, 2.0], yaw: 180.0, pitch: -20.0, fov: 70.0, doors: doors.to_vec(), flip_x: false, flip_y: false }
+    }
+
+    #[test]
+    fn only_the_cameras_of_the_open_doors_are_shown() {
+        let cams = [cam(&[1]), cam(&[2]), cam(&[3]), cam(&[2, 3])];
+        assert_eq!(shown_cameras(&cams, &[false, true, false], false), vec![1, 3], "door 2: its two cameras only");
+        assert_eq!(shown_cameras(&cams, &[false, false, true], false), vec![2, 3]);
+        assert_eq!(shown_cameras(&cams, &[true, false, true], false), vec![0, 2, 3], "doors 1 and 3 together");
+        assert!(shown_cameras(&cams, &[false, false, false], false).is_empty(), "all closed: none");
+        assert_eq!(shown_cameras(&cams, &[false, true, false], true), vec![0, 1, 2, 3], "'any door' shows every camera");
+        assert!(shown_cameras(&cams, &[false, false, false], true).is_empty());
+    }
+
+    #[test]
+    fn the_popup_follows_the_doors_that_have_a_camera() {
+        let cams = [cam(&[3]), cam(&[2])];
+        assert!(!popup_visible(&cams, &[true, false, false, false], false), "door 1 has no camera");
+        assert!(popup_visible(&cams, &[false, true, false, false], false));
+        assert!(popup_visible(&cams, &[false, false, true, false], false));
+        // one door closing changes nothing while the other stays open; both closed: down
+        assert!(popup_visible(&cams, &[false, true, false, false], false));
+        assert!(!popup_visible(&cams, &[false, false, false, false], false));
+    }
+
+    #[test]
+    fn the_all_doors_trigger_shows_it_for_any_door() {
+        let cams = [cam(&[3])];
+        assert!(popup_visible(&cams, &[true, false, false], true));
+        assert!(!popup_visible(&cams, &[false, false, false], true));
+        assert!(!popup_visible(&[], &[true], true), "no camera, nothing to show");
+    }
+
+    #[test]
+    fn a_door_the_bus_does_not_have_is_not_open() {
+        assert!(!popup_visible(&[cam(&[9])], &[true, true], false));
+        assert!(!popup_visible(&[cam(&[0])], &[true, true], false));
+    }
+
+    #[test]
+    fn the_pictures_sit_side_by_side_in_the_window() {
+        let r = layout(3, 1600.0, 900.0);
+        assert_eq!(r.len(), 3);
+        for w in r.windows(2) {
+            assert!(w[1][0] > w[0][2], "in order and apart: {w:?}");
+        }
+        for q in &r {
+            assert!(q[0] >= 0.0 && q[2] <= 1600.0 && q[3] <= 900.0, "inside: {q:?}");
+            assert!(((q[2] - q[0]) / (q[3] - q[1]) - ASPECT).abs() < 0.01, "1.6:1: {q:?}");
+        }
+        let (l, rt) = (r[0][0], 1600.0 - r[2][2]);
+        assert!((l - rt).abs() < 0.5, "centred: {l} {rt}");
+    }
+
+    #[test]
+    fn many_cameras_shrink_to_fit_across() {
+        let r = layout(8, 800.0, 900.0);
+        assert!(r[7][2] <= 800.0 && r[0][0] >= 0.0, "{r:?}");
+        assert!(layout(0, 800.0, 600.0).is_empty());
+    }
+
+    #[test]
+    fn a_world_view_becomes_the_bus_frame() {
+        // a bus turned to face east (+x): its front is east, its right is south
+        let rot = Mat4::from_rotation_z(-std::f32::consts::FRAC_PI_2);
+        let bus = DVec3::new(100.0, 200.0, 0.0);
+        // an eye 3 m east of the bus (= 3 m ahead of it), 2 m up, looking back west at it
+        let (pos, yaw, pitch) = to_bus_frame(bus, rot, bus + DVec3::new(3.0, 0.0, 2.0), Vec3::new(-1.0, 0.0, 0.0));
+        assert!((pos[0]).abs() < 1e-4 && (pos[1] - 3.0).abs() < 1e-4 && (pos[2] - 2.0).abs() < 1e-4, "{pos:?}");
+        assert!((yaw.abs() - 180.0).abs() < 1e-3, "looks back: {yaw}");
+        assert!(pitch.abs() < 1e-3);
+        // one on the bus's right (south), looking north (= to the bus's left)
+        let (pos, yaw, _) = to_bus_frame(bus, rot, bus + DVec3::new(0.0, -2.0, 0.0), Vec3::new(0.0, 1.0, 0.0));
+        assert!((pos[0] - 2.0).abs() < 1e-4 && pos[1].abs() < 1e-4, "{pos:?}");
+        assert!((yaw + 90.0).abs() < 1e-3, "looks left: {yaw}");
+    }
+
+
+    #[test]
+    fn a_damaged_line_is_left_out() {
+        assert!(parse_cam("x;1,2;0;0;70;1;").is_none());
+        assert!(parse_cam("x;1,2,3;nan;0;70;1;").is_none());
+        assert!(parse_cam("short").is_none());
+    }
+
+    #[test]
+    fn a_name_cannot_break_the_line() {
+        let c = DoorCam { name: "a|b=c;d".into(), ..cam(&[1]) };
+        let back = parse_cam(&format_cam(&c)).unwrap();
+        assert_eq!(back.name, "abcd");
+    }
+}

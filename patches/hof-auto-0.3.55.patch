+    let w = TrafficLightController::new(vec![vec![(0, 10.0), (6, 50.0), (0, 40.0)]], 100.0);
+    assert!((w.max_red() - 50.0).abs() < 0.3, "{}", w.max_red());
+    // never red: nothing
+    let g = TrafficLightController::new(vec![vec![(6, 100.0)]], 100.0);
+    assert_eq!(g.max_red(), 0.0);
+}

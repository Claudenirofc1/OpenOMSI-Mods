+    /// Scan every 5 s for `secs` seconds; the cars stand where they are. A removal is carried out
+    /// as the world does (the car is gone from the next scan, the ones behind get their time).
+    fn run(u: &mut Unstick, from: f32, secs: f32, limit: f32, snaps: &[Snap]) -> Vec<Action> {
+        let mut all = Vec::new();
+        let mut live: Vec<Snap> = snaps.to_vec();
+        let mut t = from;
+        while t < from + secs {
+            t += SCAN_EVERY;
+            let acts = u.scan(t, limit, &live);
+            for a in &acts {
+                if let Action::Remove { id, followers, stood, why } = a {
+                    u.removed_one(t, *id, followers.clone(), *stood, why);
+                    live.retain(|s| s.id != *id);
+                }
+            }
+            all.extend(acts);
+        }
+        all
+    }
+    fn removals(a: &[Action]) -> Vec<u64> {
+        a.iter().filter_map(|x| if let Action::Remove { id, .. } = x { Some(*id) } else { None }).collect()

+    fn snap(id: u64, lead: Option<u64>) -> Snap {
+        Snap { id, odometer: 100.0 + id as f32, speed: 0.0, is_bus: false, held_legit: false, why: "lead", yielding: false, lead, player_block: false, visible: false, x: id as f64 * 8.0, y: 0.0, lane: 0, s: 10.0 }

+#[test]
+fn a_declared_depot_that_lacks_a_destination_while_another_has_it_blocks() {
+    let s = Scene::new("amb", "Depot A");
+    s.hof("a.hof", "Depot A", &["1 Centro"]);
+    s.hof("c.hof", "Depot C", &["1 Centro", "1 Bairro"]);
+    let a = s.run(&tour("GroupX", &["1 Centro", "1 Bairro"]));
+    assert_eq!(a.status, Some(Status::Ambiguous));
+    assert!(a.block && !a.proven, "{a:?}");
+    assert_eq!(a.hof, "LEGACY", "nothing is picked: the caller shows the block and the official choice stays untouched");
+    assert_eq!(a.candidates, vec!["Depot C".to_string()]);
+}

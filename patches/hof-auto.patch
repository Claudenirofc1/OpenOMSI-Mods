diff --git a/crates/omsi-app/src/dashcam.rs b/crates/omsi-app/src/dashcam.rs
new file mode 100644
index 00000000..8a084530
--- /dev/null
+++ b/crates/omsi-app/src/dashcam.rs
@@ -0,0 +1,434 @@
+//! Dashcam (openOMSI HOF-Auto add-on): a camera on the bus - the windscreen's, or wherever the
+//! player put it - recorded to an `.mp4` from the moment he starts it until he stops it, while
+//! he plays and records the screen with whatever he likes. A second view of the trip: the
+//! ticket seller's, the passenger's by the driver.
+//!
+//! * The picture is drawn into a texture of its own (1280 x 720, 16:9) the way a mirror is, up
+//!   to 30 times a second, read back and handed to `ffmpeg` on a thread of its own (a frame that
+//!   finds the thread busy is dropped, the game never waits for the encoder).
+//! * `ffmpeg` is looked for in `OPENOMSI_FFMPEG`, beside the game, in `~/.openomsi/bin` and on
+//!   the PATH. Without it recording does not start and says so.
+//! * Keys (Ctrl+J family): Ctrl+J starts and stops, Ctrl+Shift+J puts the camera where the view
+//!   is now (the free camera's too; kept per bus in `dashcam.cfg`), Ctrl+Alt+J turns the
+//!   "security camera" look (a clock and the camera's name over the picture) on or off.
+//! * The files go to `Videos/openOMSI-dashcam` of the user (else `~/.openomsi/dashcam`),
+//!   numbered `dashcam-0001.mp4`, ...; a fragmented `.mp4`, which plays even when the game is
+//!   closed without stopping it.
+
+use crate::player::Player;
+use glam::{DVec3, Vec3};
+use omsi_render::{Camera, Lighting, Renderer, Scene, TextureId};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::sync::mpsc::{sync_channel, SyncSender, TrySendError};
+use std::time::{Duration, Instant};
+
+pub(crate) const WIDTH: u32 = 1280;
+pub(crate) const HEIGHT: u32 = 720;
+pub(crate) const FPS: u32 = 30;
+
+/// Where the dashcam of a bus is and how its picture looks.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct DashCfg {
+    pub pos: [f32; 3],
+    pub yaw: f32,
+    pub pitch: f32,
+    pub fov: f32,
+    /// A clock and the camera's name over the picture.
+    pub cctv: bool,
+    pub name: String,
+}
+
+impl Default for DashCfg {
+    fn default() -> Self {
+        DashCfg { pos: [0.0; 3], yaw: 0.0, pitch: 0.0, fov: 70.0, cctv: false, name: "CAM 1".into() }
+    }
+}
+
+struct Recording {
+    child: Child,
+    tx: SyncSender<Vec<u8>>,
+    writer: Option<std::thread::JoinHandle<()>>,
+    path: PathBuf,
+    frames: u64,
+    dropped: u64,
+    started: Instant,
+}
+
+/// A recording asked for and not started: `ffmpeg` is started with the first picture, which
+/// says the order of the bytes.
+struct Pending {
+    ffmpeg: PathBuf,
+    out: PathBuf,
+    cfg: DashCfg,
+}
+
+#[derive(Default)]
+pub(crate) struct Dashcam {
+    /// The bus the configuration belongs to (its `.bus` path, lower case).
+    key: String,
+    /// The player's placement of the camera (None: the driver's own view).
+    cfg: Option<DashCfg>,
+    tex: Option<TextureId>,
+    rec: Option<Recording>,
+    pending: Option<Pending>,
+    last: Option<Instant>,
+}
+
+/// The `ffmpeg` command's arguments for frames of `w` x `h` read from the standard input.
+pub(crate) fn ffmpeg_args(w: u32, h: u32, fps: u32, bgra: bool, cctv: Option<(&str, &str)>, out: &Path) -> Vec<String> {
+    let mut a: Vec<String> = ["-hide_banner", "-loglevel", "error", "-y", "-f", "rawvideo", "-pixel_format", if bgra { "bgra" } else { "rgba" }]
+        .iter()
+        .map(|s| s.to_string())
+        .collect();
+    a.extend(["-video_size".into(), format!("{w}x{h}"), "-framerate".into(), fps.to_string(), "-i".into(), "-".into()]);
+    if let Some((name, font)) = cctv {
+        // (`:` and `\` are the filter's own: the clock's format and the font's drive letter need them escaped)
+        let name = name.replace('\\', "").replace('\'', "").replace(':', "\\:").replace('%', "");
+        let font = font.replace('\\', "/").replace(':', "\\:");
+        let filter = format!(
+            "drawtext=fontfile='{font}':text='{name}   %{{localtime\\:%d/%m/%Y %H\\\\\\:%M\\\\\\:%S}}':x=24:y=24:fontsize=30:fontcolor=white:box=1:boxcolor=black@0.55:boxborderw=8"
+        );
+        a.extend(["-vf".into(), filter]);
+    }
+    a.extend(
+        ["-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p", "-movflags", "+frag_keyframe+empty_moov+default_base_moof"]
+            .iter()
+            .map(|s| s.to_string()),
+    );
+    a.push(out.to_string_lossy().into_owned());
+    a
+}
+
+/// `ffmpeg` among `candidates` (the first that `exists`).
+pub(crate) fn find_ffmpeg(candidates: &[PathBuf], exists: impl Fn(&Path) -> bool) -> Option<PathBuf> {
+    candidates.iter().find(|c| exists(c)).cloned()
+}
+
+fn ffmpeg_candidates() -> Vec<PathBuf> {
+    let exe = if cfg!(windows) { "ffmpeg.exe" } else { "ffmpeg" };
+    let mut v = Vec::new();
+    if let Some(p) = std::env::var_os("OPENOMSI_FFMPEG") {
+        v.push(PathBuf::from(p));
+    }
+    if let Some(d) = std::env::current_exe().ok().and_then(|e| e.parent().map(Path::to_path_buf)) {
+        v.push(d.join(exe));
+    }
+    if let Some(h) = std::env::var_os("USERPROFILE").or_else(|| std::env::var_os("HOME")) {
+        v.push(PathBuf::from(h).join(".openomsi").join("bin").join(exe));
+    }
+    if let Some(path) = std::env::var_os("PATH") {
+        v.extend(std::env::split_paths(&path).map(|d| d.join(exe)));
+    }
+    v
+}
+
+/// The next `dashcam-NNNN.mp4` in `dir` that does not exist yet.
+pub(crate) fn next_file(dir: &Path, exists: impl Fn(&Path) -> bool) -> PathBuf {
+    (1..).map(|n| dir.join(format!("dashcam-{n:04}.mp4"))).find(|p| !exists(p)).unwrap_or_else(|| dir.join("dashcam.mp4"))
+}
+
+fn output_dir() -> PathBuf {
+    let home = std::env::var_os("USERPROFILE").or_else(|| std::env::var_os("HOME")).map(PathBuf::from);
+    match home {
+        Some(h) if h.join("Videos").is_dir() => h.join("Videos").join("openOMSI-dashcam"),
+        Some(h) => h.join(".openomsi").join("dashcam"),
+        None => PathBuf::from("dashcam"),
+    }
+}
+
+fn system_font() -> &'static str {
+    if cfg!(windows) { "C:/Windows/Fonts/arial.ttf" } else { "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" }
+}
+
+fn file() -> Option<PathBuf> {
+    crate::settings::Settings::path().map(|p| p.with_file_name("dashcam.cfg"))
+}
+
+fn path_of(p: &Player) -> String {
+    p.vehicle.ty.def.path.to_string_lossy().into_owned()
+}
+
+impl Dashcam {
+    fn sync(&mut self, p: &Player) {
+        let path = path_of(p);
+        let key = path.to_ascii_lowercase();
+        if self.key == key {
+            return;
+        }
+        self.key = key;
+        self.cfg = file().and_then(|f| std::fs::read_to_string(f).ok()).and_then(|t| parse(&t, &self.key));
+    }
+
+    /// The camera to record: the player's, else the driver's own view.
+    fn camera(&self, p: &Player) -> omsi_vehicle::Camera {
+        match &self.cfg {
+            Some(c) => omsi_vehicle::Camera { pos: c.pos, dist: 0.0, fov: c.fov, yaw: c.yaw, pitch: c.pitch, extra: None, fixed: true },
+            None => {
+                let def = &p.vehicle.ty.def;
+                let mut c = def.cameras_driver.get(p.driver_camera_slot()).cloned().unwrap_or(omsi_vehicle::Camera { pos: [0.0, 0.0, 2.0], dist: 0.0, fov: 70.0, yaw: 0.0, pitch: 0.0, extra: None, fixed: true });
+                c.fov = 70.0;
+                c.fixed = true;
+                c
+            }
+        }
+    }
+
+    /// Ctrl+J: start or stop.
+    pub fn toggle(&mut self, p: &Player) -> String {
+        self.sync(p);
+        if !omsi_cfg::addon_switch::enabled("dashcam") && self.rec.is_none() {
+            return "Dashcam is switched off (dashcam=0 in hofauto-mods.cfg)".into();
+        }
+        if self.pending.take().is_some() && self.rec.is_none() {
+            return "Dashcam: stopped before the first picture".into();
+        }
+        if let Some(r) = self.rec.take() {
+            return finish(r);
+        }
+        let Some(ffmpeg) = find_ffmpeg(&ffmpeg_candidates(), |c| c.is_file()) else {
+            return "Dashcam: ffmpeg was not found (put ffmpeg.exe beside the game or in .openomsi\\bin, or set OPENOMSI_FFMPEG)".into();
+        };
+        let dir = output_dir();
+        if let Err(e) = std::fs::create_dir_all(&dir) {
+            return format!("Dashcam: the folder {} could not be made: {e}", dir.display());
+        }
+        let out = next_file(&dir, |p| p.exists());
+        let msg = format!("Dashcam recording to {} (Ctrl+J stops it)", out.display());
+        self.last = None;
+        self.pending = Some(Pending { ffmpeg, out, cfg: self.cfg.clone().unwrap_or_default() });
+        msg
+    }
+
+    /// Ctrl+Shift+J: the camera goes where the view is now.
+    pub fn register(&mut self, p: &Player, eye: DVec3, forward: Vec3, fov: f32) -> String {
+        self.sync(p);
+        let (pos, yaw, pitch) = crate::door_cams::to_bus_frame(p.vehicle.position, p.vehicle.body_rotation(), eye, forward);
+        let mut c = self.cfg.clone().unwrap_or_default();
+        c.pos = pos;
+        c.yaw = yaw;
+        c.pitch = pitch.clamp(-89.0, 89.0);
+        c.fov = if fov > 10.0 { fov.clamp(30.0, 110.0) } else { 70.0 };
+        self.cfg = Some(c);
+        self.save();
+        format!("Dashcam placed at {:.1}, {:.1}, {:.1} m of the bus (Ctrl+J records)", pos[0], pos[1], pos[2])
+    }
+
+    /// Ctrl+Alt+J: the security-camera look.
+    pub fn toggle_look(&mut self, p: &Player) -> String {
+        self.sync(p);
+        let mut c = self.cfg.clone().unwrap_or_default();
+        c.cctv = !c.cctv;
+        let msg = if c.cctv { "Dashcam: security camera look on (from the next recording)" } else { "Dashcam: clean picture (from the next recording)" };
+        self.cfg = Some(c);
+        self.save();
+        msg.into()
+    }
+
+    fn save(&self) {
+        let (Some(f), Some(c)) = (file(), self.cfg.as_ref()) else { return };
+        let text = std::fs::read_to_string(&f).unwrap_or_default();
+        let mut lines: Vec<String> = text
+            .lines()
+            .filter(|l| l.split_once('=').and_then(|(k, _)| k.rsplit_once('|')).is_none_or(|(p, _)| p.trim().to_ascii_lowercase() != self.key))
+            .map(str::to_string)
+            .collect();
+        lines.push(format!("{}|cam={:.3},{:.3},{:.3};{:.2};{:.2};{:.1}", self.key, c.pos[0], c.pos[1], c.pos[2], c.yaw, c.pitch, c.fov));
+        lines.push(format!("{}|look={}", self.key, if c.cctv { "cctv" } else { "clean" }));
+        lines.push(format!("{}|name={}", self.key, c.name.replace(['|', '='], "")));
+        if let Some(d) = f.parent() {
+            let _ = std::fs::create_dir_all(d);
+        }
+        let _ = std::fs::write(&f, lines.join("\n") + "\n");
+    }
+
+    /// Once a frame while recording: draw the camera's picture and hand it on, up to `FPS` times
+    /// a second. A message for the player when something goes wrong.
+    pub fn frame(&mut self, renderer: &mut Renderer, scene: &mut Scene, p: &Player, lighting: &Lighting) -> Option<String> {
+        if self.rec.is_none() && self.pending.is_none() {
+            return None;
+        }
+        if self.rec.as_mut().is_some_and(|r| r.child.try_wait().ok().flatten().is_some()) {
+            // ffmpeg ended by itself (a wrong argument, a full disk)
+            return self.rec.take().map(|r| format!("Dashcam: the encoder stopped. {}", finish(r)));
+        }
+        let gap = Duration::from_secs_f64(1.0 / FPS as f64);
+        let now = Instant::now();
+        if self.last.is_some_and(|t| now.duration_since(t) < gap) {
+            return None;
+        }
+        self.last = Some(now);
+        let tex = *self.tex.get_or_insert_with(|| renderer.add_render_texture(scene, WIDTH, HEIGHT));
+        let c = self.camera(p);
+        let (eye, yaw, pitch, roll) = p.vehicle.camera_world_full(&c);
+        let cam = Camera {
+            position: eye,
+            yaw,
+            pitch: pitch.clamp(-89.0, 89.0),
+            roll,
+            fov_deg: c.fov,
+            near: 0.1,
+            far: if renderer.options.max_obj_dist > 0.0 { renderer.options.max_obj_dist.clamp(450.0, 6000.0) } else { 3000.0 },
+        };
+        renderer.render_to_texture(scene, tex, &cam, lighting, WIDTH as f32 / HEIGHT as f32);
+        let (size, bgra, raw) = match renderer.read_render_texture(scene, tex) {
+            Ok(x) => x,
+            Err(e) => {
+                log::warn!("dashcam: the picture could not be read: {e}");
+                return None;
+            }
+        };
+        if size != (WIDTH, HEIGHT) {
+            return None;
+        }
+        if self.rec.is_none() {
+            let pd = self.pending.take()?;
+            match start(&pd.ffmpeg, &pd.out, &pd.cfg, bgra) {
+                Ok(r) => self.rec = Some(r),
+                Err(e) => return Some(format!("Dashcam: ffmpeg could not start: {e}")),
+            }
+        }
+        let rec = self.rec.as_mut()?;
+        match rec.tx.try_send(raw) {
+            Ok(()) => rec.frames += 1,
+            Err(TrySendError::Full(_)) => rec.dropped += 1,
+            Err(TrySendError::Disconnected(_)) => {}
+        }
+        None
+    }
+}
+
+fn start(ffmpeg: &Path, out: &Path, cfg: &DashCfg, bgra: bool) -> std::io::Result<Recording> {
+    let look = cfg.cctv.then_some((cfg.name.as_str(), system_font()));
+    let args = ffmpeg_args(WIDTH, HEIGHT, FPS, bgra, look, out);
+    let mut cmd = Command::new(ffmpeg);
+    cmd.args(&args).stdin(Stdio::piped()).stdout(Stdio::null()).stderr(Stdio::null());
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        cmd.creation_flags(0x0800_0000); // no console window
+    }
+    let mut child = cmd.spawn()?;
+    let mut stdin = child.stdin.take().ok_or_else(|| std::io::Error::other("no input pipe"))?;
+    let (tx, rx) = sync_channel::<Vec<u8>>(6);
+    let writer = std::thread::Builder::new().name("dashcam writer".into()).spawn(move || {
+        while let Ok(frame) = rx.recv() {
+            if stdin.write_all(&frame).is_err() {
+                break;
+            }
+        }
+    })?;
+    Ok(Recording { child, tx, writer: Some(writer), path: out.to_path_buf(), frames: 0, dropped: 0, started: Instant::now() })
+}
+
+fn finish(mut r: Recording) -> String {
+    drop(r.tx);
+    if let Some(w) = r.writer.take() {
+        let _ = w.join();
+    }
+    let _ = r.child.wait();
+    let secs = r.started.elapsed().as_secs();
+    format!("Dashcam saved: {} ({} frames, {} dropped, {}:{:02})", r.path.display(), r.frames, r.dropped, secs / 60, secs % 60)
+}
+
+fn parse(text: &str, key: &str) -> Option<DashCfg> {
+    let mut c = DashCfg::default();
+    let mut found = false;
+    for line in text.lines() {
+        let Some((head, value)) = line.split_once('=') else { continue };
+        let Some((path, what)) = head.rsplit_once('|') else { continue };
+        if path.trim().to_ascii_lowercase() != key {
+            continue;
+        }
+        match what.trim() {
+            "cam" => {
+                let f: Vec<&str> = value.split(';').collect();
+                let pos: Vec<f32> = f.first().map(|s| s.split(',').filter_map(|x| x.trim().parse().ok()).collect()).unwrap_or_default();
+                let n = |i: usize| f.get(i).and_then(|s| s.trim().parse::<f32>().ok()).filter(|x| x.is_finite());
+                if let (3, Some(yaw), Some(pitch), Some(fov)) = (pos.len(), n(1), n(2), n(3)) {
+                    c.pos = [pos[0], pos[1], pos[2]];
+                    c.yaw = yaw;
+                    c.pitch = pitch.clamp(-89.0, 89.0);
+                    c.fov = fov.clamp(20.0, 120.0);
+                    found = true;
+                }
+            }
+            "look" => c.cctv = value.trim().eq_ignore_ascii_case("cctv"),
+            "name" => c.name = value.trim().to_string(),
+            _ => {}
+        }
+    }
+    found.then_some(c)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_command_reads_raw_frames_from_the_input() {
+        let a = ffmpeg_args(1280, 720, 30, true, None, Path::new("/v/dashcam-0001.mp4"));
+        let s = a.join(" ");
+        assert!(s.contains("-f rawvideo -pixel_format bgra -video_size 1280x720 -framerate 30 -i -"), "{s}");
+        assert!(s.contains("libx264") && s.ends_with("dashcam-0001.mp4"), "{s}");
+        assert!(!s.contains("-vf"), "a clean picture has no filter: {s}");
+        assert!(ffmpeg_args(640, 360, 25, false, None, Path::new("o.mp4")).join(" ").contains("-pixel_format rgba"));
+    }
+
+    #[test]
+    fn the_security_look_puts_the_name_and_the_clock_over_the_picture() {
+        let a = ffmpeg_args(1280, 720, 30, true, Some(("CAM 1: Porta", "C:\\Windows\\Fonts\\arial.ttf")), Path::new("o.mp4"));
+        let vf = &a[a.iter().position(|x| x == "-vf").unwrap() + 1];
+        assert!(vf.starts_with("drawtext=fontfile='C\\:/Windows/Fonts/arial.ttf'"), "{vf}");
+        assert!(vf.contains("CAM 1\\: Porta") && vf.contains("%{localtime"), "{vf}");
+    }
+
+    /// With a real `ffmpeg` at hand (skipped without): both looks make a playable file from raw frames.
+    #[test]
+    fn ffmpeg_makes_a_file_of_both_looks() {
+        let Some(ff) = find_ffmpeg(&ffmpeg_candidates(), |c| c.is_file()) else { return };
+        let dir = std::env::temp_dir().join(format!("dashcam-test-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        for look in [false, true] {
+            let out = dir.join(format!("look-{look}.mp4"));
+            let cfg = DashCfg { cctv: look, name: "CAM 1: Porta".into(), ..Default::default() };
+            let mut rec = start(&ff, &out, &cfg, true).expect("ffmpeg starts");
+            let frame = vec![90u8; (WIDTH * HEIGHT * 4) as usize];
+            for _ in 0..20 {
+                rec.tx.send(frame.clone()).unwrap();
+            }
+            let msg = finish(rec);
+            assert!(msg.contains("saved"), "{msg}");
+            let size = std::fs::metadata(&out).map(|m| m.len()).unwrap_or(0);
+            assert!(size > 1000, "{look}: the file is {size} bytes");
+        }
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn the_first_ffmpeg_that_exists_is_taken() {
+        let c = [PathBuf::from("/a/ffmpeg"), PathBuf::from("/b/ffmpeg"), PathBuf::from("/c/ffmpeg")];
+        assert_eq!(find_ffmpeg(&c, |p| p.starts_with("/b") || p.starts_with("/c")), Some(PathBuf::from("/b/ffmpeg")));
+        assert_eq!(find_ffmpeg(&c, |_| false), None);
+    }
+
+    #[test]
+    fn the_files_are_numbered_on() {
+        let taken = [PathBuf::from("/v/dashcam-0001.mp4"), PathBuf::from("/v/dashcam-0002.mp4")];
+        assert_eq!(next_file(Path::new("/v"), |p| taken.iter().any(|t| t == p)), PathBuf::from("/v/dashcam-0003.mp4"));
+        assert_eq!(next_file(Path::new("/v"), |_| false), PathBuf::from("/v/dashcam-0001.mp4"));
+    }
+
+    #[test]
+    fn the_file_keeps_the_camera_of_each_bus_apart() {
+        let text = "vehicles/a/a.bus|cam=0.500,-3.200,2.100;181.50;-12.00;80.0\nvehicles/a/a.bus|look=cctv\nvehicles/a/a.bus|name=Traseira\nvehicles/b/b.bus|cam=1,2,3;0;0;60\n";
+        let a = parse(text, "vehicles/a/a.bus").unwrap();
+        assert_eq!(a.pos, [0.5, -3.2, 2.1]);
+        assert!((a.yaw - 181.5).abs() < 1e-3 && (a.pitch + 12.0).abs() < 1e-3 && (a.fov - 80.0).abs() < 1e-3);
+        assert!(a.cctv && a.name == "Traseira");
+        assert!(!parse(text, "vehicles/b/b.bus").unwrap().cctv);
+        assert!(parse(text, "vehicles/none.bus").is_none());
+        assert!(parse("vehicles/a/a.bus|cam=1,2;0;0;60\n", "vehicles/a/a.bus").is_none(), "a damaged line is left out");
+    }
+}

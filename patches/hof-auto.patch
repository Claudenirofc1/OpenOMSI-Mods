+//! LOCAL (hof-auto prototype): the glue of the automatic depot-file choice (`auto_for_paths`)
+//! over a SYNTHETIC installation written to a temporary folder (invented names; no third-party
+//! content): declared depot from `ailists.cfg`, the depot files a bus sees, ambiguity, no match,
+//! duplicate `[name]`, and a manual-choice-free fallback.
+use omsi_launcher_lib::hof_auto::{auto_for_paths, Severity, Status};
+use omsi_launcher_lib::{StopInfo, TourInfo, TripInfo};
+use std::path::{Path, PathBuf};
+
+fn hof_text(name: &str, dests: &[&str]) -> String {
+    let mut t = format!("[name]\n{name}\n\nstringcount_terminus\n2\n");
+    for (i, d) in dests.iter().enumerate() {
+        t.push_str(&format!("[addterminus]\n{}\n{d}\n{d}\n{d}\n", 100 + i));
+    }
+    t
+}
+
+fn trip(name: &str, to: &str) -> TripInfo {
+    TripInfo { name: name.into(), index: 1, line: "9".into(), from: "Start".into(), terminus: to.into(), departure: 0.0, arrival: 0.0, stops: vec![StopInfo { name: "Start".into(), arr: 0.0, dep: 0.0 }, StopInfo { name: to.into(), arr: 0.0, dep: 0.0 }], km: 1.0 }
+}
+
+fn tour(group: &str, dests: &[&str]) -> TourInfo {
+    TourInfo { id: "1".into(), number: "1".into(), ai_group: group.into(), first: 0.0, last: 0.0, days: "daily".into(), runs: true, next_run: None, trips: dests.iter().enumerate().map(|(i, d)| trip(&format!("trip{i}"), d)).collect() }
+}
+
+struct Scene {
+    root: PathBuf,
+}
+impl Scene {
+    fn new(tag: &str, declares: &str) -> Scene {
+        let root = std::env::temp_dir().join(format!("hofauto-glue-{tag}-{}", std::process::id()));
+        std::fs::create_dir_all(root.join("maps/M")).unwrap();
+        std::fs::create_dir_all(root.join("Vehicles/B")).unwrap();
+        std::fs::write(root.join("maps/M/ailists.cfg"), format!("[aigroup_depot]\nGroupX\n{declares}\n")).unwrap();
+        Scene { root }
+    }
+    fn hof(&self, file: &str, name: &str, dests: &[&str]) {
+        std::fs::write(self.root.join("Vehicles/B").join(file), hof_text(name, dests)).unwrap();
+    }
+    fn run(&self, t: &TourInfo) -> omsi_launcher_lib::hof_auto::Auto {
+        auto_for_paths(&self.root.join("maps/M"), &self.root.join("Vehicles/B"), "1989-05-30", t, "LEGACY".into())
+    }
+}
+impl Drop for Scene {
+    fn drop(&mut self) {
+        let _: &Path = &self.root;
+        std::fs::remove_dir_all(&self.root).ok();
+    }
+}

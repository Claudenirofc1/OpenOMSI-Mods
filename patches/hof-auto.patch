+    #[test]
+    fn several_covers_with_equal_strength_are_ambiguous() {
+        let a = hof("A", vec![term("X", None, &["X"])]);
+        let b = hof("B", vec![term("X", None, &["X"])]);
+        let d = evaluate(None, &[need("t1", "X")], &[&a, &b]);
+        assert_eq!(d.status, Status::Ambiguous);
+    }
+
+    #[test]
+    fn exact_beats_normalized_on_a_tie_break() {
+        let a = hof("A", vec![term("X Y", None, &["X Y"])]);
+        let b = hof("B", vec![term("x  y", None, &["x y"])]);
+        let d = evaluate(None, &[need("t1", "X Y")], &[&a, &b]);
+        assert_eq!((d.status, d.hof.as_deref()), (Status::ProvenTieBreak, Some("A")));
+    }
+
+    #[test]
+    fn displayed_text_alone_never_proves() {
+        // "Barreiros" appears only as a displayed string of another destination: line-blind
+        let a = hof("A", vec![term("1 Centro", None, &["CENTRO", "Barreiros"])]);
+        let d = evaluate(Some("A"), &[need("t1", "Barreiros")], &[&a]);
+        assert_eq!(d.status, Status::FlexibleDeclared);
+        assert!(!d.status.is_proven());
+        assert_eq!(d.status.severity(), Severity::Warn);
+    }
+
+    #[test]
+    fn nothing_matches_keeps_the_usual_choice_unproven() {
+        let a = hof("A", vec![term("X", None, &["X"])]);
+        let d = evaluate(Some("A"), &[need("t1", "Nowhere")], &[&a]);
+        assert_eq!(d.status, Status::NoMatch);
+        assert!(d.hof.is_none(), "the module picks nothing; the caller keeps the official pick");
+    }
+
+    #[test]
+    fn a_tour_without_destinations_is_flagged() {
+        let a = hof("A", vec![]);
+        let d = evaluate(Some("A"), &[need("depot run", "")], &[&a]);
+        assert_eq!(d.status, Status::NoTrips);
+        assert!(d.hof.is_none(), "no evidence: the official choice is kept, not the declared one");
+        let d = evaluate(None, &[], &[&a]);
+        assert_eq!(d.status, Status::NoTrips);
+    }
+
+    #[test]
+    fn a_line_number_alone_is_not_evidence() {
+        // both HOFs carry an IBIS trip for line "1"; only B has the destination
+        let mut a = hof("A", vec![term("Else", None, &["Else"])]);
+        a.info_trips = vec![InfoTrip { code: "1".into(), name: "t".into(), route: "r".into(), line: "1".into(), ..Default::default() }];
+        let b = hof("B", vec![term("X", None, &["X"])]);
+        let d = evaluate(Some("A"), &[need("t1", "X")], &[&a, &b]);
+        assert_eq!(d.status, Status::Ambiguous, "A is declared and has the line number, but not the destination");
+        assert_eq!(d.proven, vec![("B".to_string(), Level::Exact)]);
+    }
+
+    #[test]
+    fn duplicate_names_with_different_content_are_found() {
+        let dir = std::env::temp_dir().join(format!("hofauto-dups-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let (p1, p2, p3) = (dir.join("a.hof"), dir.join("b.hof"), dir.join("c.hof"));
+        std::fs::write(&p1, b"one").unwrap();
+        std::fs::write(&p2, b"two").unwrap();
+        std::fs::write(&p3, b"one").unwrap();
+        let mk = |n: &str, p: &PathBuf| Hof { name: n.into(), path: p.clone(), ..Default::default() };
+        let (h1, h2, h3, h4) = (mk("Same", &p1), mk("same ", &p2), mk("Twin", &p1), mk("twin", &p3));
+        let d = duplicate_names(&[&h1, &h2, &h3, &h4]);
+        std::fs::remove_dir_all(&dir).ok();
+        assert_eq!(d.len(), 2);
+        let same = d.iter().find(|x| x.name == "same").unwrap();
+        let twin = d.iter().find(|x| x.name == "twin").unwrap();
+        assert!(!same.identical, "different content = risk");
+        assert!(twin.identical, "same bytes = harmless");
+    }
+
+    #[test]
+    fn declared_depot_follows_the_chrono_scenario_and_the_group() {
+        let dir = std::env::temp_dir().join(format!("hofauto-chrono-{}", std::process::id()));
+        let era = dir.join("Chrono").join("Era2");
+        std::fs::create_dir_all(&era).unwrap();
+        std::fs::write(dir.join("ailists.cfg"), "[aigroup_depot]\nGroupA\nDepotOld\n\n[aigroup_depot]\nGroupB\nDepotB\n").unwrap();
+        std::fs::write(era.join("Chrono.cfg"), "[startdate]\n19950101\n").unwrap();
+        std::fs::write(era.join("ailists.cfg"), "[aigroup_depot]\nGroupA\nDepotNew\n").unwrap();
+        let before = declared_depot(&dir, 19900101, "GroupA");
+        let during = declared_depot(&dir, 20000101, " groupa ");
+        let other = declared_depot(&dir, 19900101, "GroupB");
+        // (a scenario's full ailists.cfg replaces the map's: the official reader's rule)
+        let replaced = declared_depot(&dir, 20000101, "GroupB");
+        let none = declared_depot(&dir, 20000101, "NoSuchGroup");
+        std::fs::remove_dir_all(&dir).ok();
+        assert_eq!(before.as_deref(), Some("DepotOld"));
+        assert_eq!(during.as_deref(), Some("DepotNew"), "an active chrono scenario moves the depot");
+        assert_eq!(other.as_deref(), Some("DepotB"));
+        assert_eq!(replaced, None, "the scenario's own ailists.cfg replaces the map's");
+        assert_eq!(none, None, "a missing group declares nothing");
+    }
+
+    #[test]
+    fn outbound_and_return_trips_must_both_be_covered() {
+        // ida/volta: the outbound destination is in A, the return one only in B
+        let a = hof("A", vec![term("1 Centro", None, &["Centro"])]);
+        let b = hof("B", vec![term("1 Centro", None, &["Centro"]), term("1 Bairro", None, &["Bairro"])]);
+        let trips = [need("ida", "1 Bairro"), need("volta", "1 Centro")];
+        let d = evaluate(Some("A"), &trips, &[&a, &b]);
+        assert_eq!(d.status, Status::Ambiguous, "the declared A lacks the outbound destination while B has both");
+        let d = evaluate(Some("B"), &trips, &[&a, &b]);
+        assert_eq!((d.status, d.hof.as_deref()), (Status::ProvenDeclared, Some("B")));
+    }
+
+    #[test]
+    fn a_bus_own_depot_file_hides_a_shared_one_of_the_same_name() {
+        let own = Hof { name: "Depot".into(), path: "own/depot.hof".into(), termini: vec![term("X", None, &["X"])], ..Default::default() };
+        let shared = Hof { name: "depot ".into(), path: "HOFs/depot.hof".into(), termini: vec![term("Y", None, &["Y"])], ..Default::default() };
+        let other = hof("Other", vec![]);
+        let all = [own, shared, other];
+        let u = unique_by_name(&all);
+        assert_eq!(u.len(), 2);
+        assert_eq!(u[0].path, PathBuf::from("own/depot.hof"), "the file nearest the bus is the one the name resolves to");
+    }
+
+    #[test]
+    fn the_switch_gives_the_official_choice_and_missing_data_falls_back() {
+        static ENV: std::sync::Mutex<()> = std::sync::Mutex::new(());
+        let _g = ENV.lock().unwrap_or_else(|e| e.into_inner());
+        let old = std::env::var(ENV_SWITCH).ok();
+        // SAFETY: serialised by the mutex above; no other test reads this variable
+        unsafe { std::env::set_var(ENV_SWITCH, "off") };
+        let off = auto_for(None, None, "1989-05-30", Some("1"), Some("1"));
+        unsafe { std::env::remove_var(ENV_SWITCH) };
+        let on_without_data = auto_for(None, None, "1989-05-30", Some("1"), Some("1"));
+        let free_drive = auto_for(None, None, "1989-05-30", None, None);
+        match old {
+            Some(v) => unsafe { std::env::set_var(ENV_SWITCH, v) },
+            None => {}
+        }
+        assert_eq!(off.engine, "official");
+        assert!(!off.block && !off.proven && off.status.is_none());
+        assert_eq!(on_without_data.engine, "official", "no map/bus/tour: the official choice, never a guess");
+        assert!(!on_without_data.block && !on_without_data.proven);
+        assert_eq!(free_drive.engine, "official");
+    }
+
+    #[test]
+    fn messages_exist_in_brazilian_portuguese() {
+        let pt = crate::i18n::table(crate::i18n::TABLES, "pt");
+        for key in [
+            "The tour has no trip with a destination to check; the depot file is not confirmed.",
+            "The map declares {hof} for this tour but it does not hold every destination ({level}); these do: {list}. Choose the depot file by hand.",
+            "Several depot files have every destination of the tour with nothing to tell them apart: {list}. Choose the depot file by hand.",
+            "No depot file holds the destinations of this tour; the usual choice is kept but it is NOT confirmed.",
+            "Warning: more than one depot file is called {list} with different content; the game picks by name and may use another file than the one checked.",
+            "OPENOMSI_HOF_AUTO is off: the official choice is used.",
+            "exact",
+            "displayed text",
+        ] {
+            let v = pt.get(key).unwrap_or_else(|| panic!("missing pt: {key}"));
+            assert!(!v.trim().is_empty() && v != key, "{key}");
+            // the placeholders survive the translation
+            for ph in ["{hof}", "{level}", "{list}", "{n}", "{name}"] {
+                assert_eq!(key.contains(ph), v.contains(ph), "{ph} in {key}");
+            }
+        }
+    }
+}

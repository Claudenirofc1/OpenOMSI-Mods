+#[test]
+fn the_declared_depot_that_covers_the_tour_is_proven_and_not_blocked() {
+    let s = Scene::new("ok", "Depot A");
+    s.hof("a.hof", "Depot A", &["1 Centro", "1 Bairro"]);
+    s.hof("b.hof", "Depot B", &["1 Centro"]);
+    let a = s.run(&tour("GroupX", &["1 Centro", "1 Bairro"]));
+    assert_eq!(a.engine, "hof_auto");
+    assert_eq!((a.status, a.hof.as_str()), (Some(Status::ProvenDeclared), "Depot A"));
+    assert!(a.proven && !a.block && a.severity == Severity::Ok, "{a:?}");
+}

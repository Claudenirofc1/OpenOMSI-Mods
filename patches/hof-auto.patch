+#[test]
+fn no_depot_has_the_destinations_keeps_the_legacy_choice_unproven() {
+    let s = Scene::new("none", "Depot A");
+    s.hof("a.hof", "Depot A", &["1 Centro"]);
+    let a = s.run(&tour("GroupX", &["9 Nowhere"]));
+    assert_eq!(a.status, Some(Status::NoMatch));
+    assert_eq!(a.severity, Severity::Warn);
+    assert!(!a.proven && !a.block);
+    assert_eq!(a.hof, "LEGACY");
+}
+
+#[test]
+fn two_files_with_one_internal_name_and_different_content_are_flagged_and_not_proven() {
+    let s = Scene::new("dup", "Depot A");
+    s.hof("a.hof", "Depot A", &["1 Centro"]);
+    s.hof("a-edit.hof", "Depot A", &["1 Centro", "1 Extra"]);
+    let a = s.run(&tour("GroupX", &["1 Centro"]));
+    assert_eq!(a.status, Some(Status::ProvenDeclared));
+    assert_eq!(a.duplicates.len(), 1, "{a:?}");
+    assert!(!a.proven, "a name two different files share cannot be proven: the game picks by name");
+    assert_eq!(a.severity, Severity::Warn);
+}
+
+#[test]
+fn a_group_the_map_does_not_declare_still_finds_the_one_depot_that_covers() {
+    let s = Scene::new("undeclared", "Depot A");
+    s.hof("a.hof", "Depot A", &["1 Centro"]);
+    s.hof("d.hof", "Depot D", &["2 Praca"]);
+    let a = s.run(&tour("OtherGroup", &["2 Praca"]));
+    assert_eq!((a.status, a.hof.as_str()), (Some(Status::ProvenUnique), "Depot D"));
+}
+
+#[test]
+fn a_bad_date_or_no_depot_files_falls_back_to_the_official_choice() {
+    let s = Scene::new("bad", "Depot A");
+    let a = auto_for_paths(&s.root.join("maps/M"), &s.root.join("Vehicles/B"), "not-a-date", &tour("GroupX", &["x"]), "LEGACY".into());
+    assert_eq!((a.engine, a.hof.as_str(), a.block), ("official", "LEGACY", false));
+    let a = s.run(&tour("GroupX", &["x"]));
+    assert_eq!((a.engine, a.hof.as_str(), a.block), ("official", "LEGACY", false), "no depot file at all: nothing to judge");
+}
diff --git a/crates/omsi-launcher-core/tests/hof_auto_regression.rs b/crates/omsi-launcher-core/tests/hof_auto_regression.rs
new file mode 100644
index 00000000..68b7777f
--- /dev/null
+++ b/crates/omsi-launcher-core/tests/hof_auto_regression.rs
@@ -0,0 +1,159 @@
+//! LOCAL (hof-auto prototype): regression of the automatic depot-file choice against the
+//! approved matrix, over disposable COPIES of third-party maps and depot files.
+//!
+//! Third-party content is never part of the repository. The test needs two environment
+//! variables and is reported as NOT EXECUTED (not as passed) when they are missing:
+//!
+//!   HOF_AUTO_FIXTURES  folder with `HOFs/*.hof` and `maps/<map>/{TTData,ailists.cfg,...}`
+//!   HOF_AUTO_MATRIX    the approved matrix (TSV, columns MAPA LINHA TOUR GRUPO N_VIAGENS
+//!                      DECLARADO NOVO_STATUS NOVO_HOF ...)
+//!   HOF_AUTO_REPORT    (optional) file to write the verdict line to
+//!
+//! Run through `local/scripts/run-tests.sh`, which turns a missing-data run into the words
+//! "NAO EXECUTADO" and a non-zero exit code of its own.
+use omsi_launcher_lib::hof_auto::{declared_depot, duplicate_names, evaluate, unique_by_name, Need, Status};
+use omsi_vehicle::Hof;
+use std::collections::BTreeSet;
+use std::path::PathBuf;
+
+fn word(s: Status) -> &'static str {
+    match s {
+        Status::ProvenDeclared => "PROVADO_DECLARADO",
+        Status::ProvenUnique => "PROVADO_UNICO",
+        Status::ProvenTieBreak => "PROVADO_DESEMPATE",
+        Status::FlexibleDeclared => "FLEXIVEL_DECLARADO",
+        Status::Ambiguous => "AMBIGUO",
+        Status::NoMatch => "SEM_CORRESPONDENCIA",
+        Status::NoTrips => "SEM_VIAGENS",
+    }
+}
+
+/// The class compared with the matrix: the three PROVADO_* statuses are one class (same proof,
+/// same file); how the proof was reached (declared / unique / tie-break) is only counted.
+fn class(status: &str) -> &str {
+    if status.starts_with("PROVADO") {
+        "PROVADO"
+    } else {
+        status
+    }
+}
+
+fn verdict(line: &str) {
+    println!("HOF_AUTO_REGRESSION: {line}");
+    if let Ok(p) = std::env::var("HOF_AUTO_REPORT") {
+        let _ = std::fs::write(p, format!("{line}\n"));
+    }
+}
+
+#[test]
+fn matches_the_approved_matrix() {
+    let (Ok(fx), Ok(matrix)) = (std::env::var("HOF_AUTO_FIXTURES"), std::env::var("HOF_AUTO_MATRIX")) else {
+        verdict("NAO EXECUTADO (HOF_AUTO_FIXTURES / HOF_AUTO_MATRIX not set)");
+        return;
+    };
+    let fx = PathBuf::from(fx);
+    let mut files: Vec<PathBuf> = std::fs::read_dir(fx.join("HOFs"))
+        .expect("HOFs folder")
+        .filter_map(|e| e.ok())
+        .map(|e| e.path())
+        .filter(|p| p.extension().is_some_and(|e| e.eq_ignore_ascii_case("hof")))
+        .collect();
+    files.sort_by_key(|f| f.file_name().unwrap().to_string_lossy().to_ascii_lowercase());
+    let hofs: Vec<Hof> = files.iter().filter_map(|f| Hof::load(f).ok()).collect();
+    // as the product does: each [name] once, the first file (own folder, then shared, by file name) winning
+    let refs: Vec<&Hof> = unique_by_name(&hofs);
+    assert!(!refs.is_empty(), "no depot file could be read");
+
+    let dups = duplicate_names(&hofs.iter().collect::<Vec<_>>());
+    let risky = dups.iter().filter(|d| !d.identical).count();
+    println!("duplicate [name] among the depot files: {} names, {} with different content (INFO; the risk the module warns about)", dups.len(), risky);
+    for d in dups.iter().filter(|d| !d.identical) {
+        println!("  DUP {} x{}", d.name, d.files.len());
+    }
+
+    let mut maps: Vec<PathBuf> = std::fs::read_dir(fx.join("maps")).expect("maps folder").filter_map(|e| e.ok()).map(|e| e.path()).collect();
+    maps.sort();
+    let mut got: BTreeSet<String> = BTreeSet::new();
+    let mut got_status: std::collections::BTreeMap<String, &'static str> = Default::default();
+    let mut got_n = 0usize;
+    let mut ambiguous = 0usize;
+    let (mut eval_total, mut eval_max) = (std::time::Duration::ZERO, std::time::Duration::ZERO);
+    for md in maps {
+        let mname = md.file_name().unwrap().to_string_lossy().to_string();
+        let data = omsi_timetable::TimetableData::load(&md);
+        for l in &data.lines {
+            for t in &l.tours {
+                let mut seen = BTreeSet::new();
+                let mut needs: Vec<Need> = Vec::new();
+                for tt in &t.trips {
+                    let Some(trip) = data.trips.iter().find(|x| x.is_named(&tt.trip)) else { continue };
+                    if !seen.insert(trip.name.to_lowercase()) {
+                        continue;
+                    }
+                    needs.push(Need {
+                        name: trip.name.clone(),
+                        line: trip.line.trim().to_string(),
+                        terminus: trip.terminus.trim().to_string(),
+                        stops: trip.stations_legacy.iter().filter_map(|r| r.get(2).map(|n| n.trim().to_string())).collect(),
+                    });
+                }
+                let group = t.ai_group.trim().to_string();
+                // the default date of the game and the launcher (day 150 of 1989), no scenario
+                let declared = declared_depot(&md, 19890530, &group);
+                let t0 = std::time::Instant::now();
+                let d = evaluate(declared.as_deref(), &needs.iter().filter(|n| !n.terminus.is_empty()).cloned().collect::<Vec<_>>(), &refs);
+                let spent = t0.elapsed();
+                eval_total += spent;
+                eval_max = eval_max.max(spent);
+                if d.status == Status::Ambiguous {
+                    ambiguous += 1;
+                }
+                let key = format!("{mname}|{}|{}|{group}", l.name, t.number);
+                got_status.insert(key.clone(), word(d.status));
+                got.insert(format!("{key}|{}|{}", class(word(d.status)), d.hof.unwrap_or_default().trim()));
+                got_n += 1;
+            }
+        }
+    }
+
+    let text = std::fs::read_to_string(&matrix).expect("matrix file");
+    let mut want: BTreeSet<String> = BTreeSet::new();
+    let mut want_n = 0usize;
+    let mut refined = 0usize;
+    let mut pairs: std::collections::BTreeMap<String, usize> = Default::default();
+    for row in text.lines().skip(1) {
+        let c: Vec<&str> = row.split('\t').collect();
+        if c.len() < 8 {
+            continue;
+        }
+        want.insert(format!("{}|{}|{}|{}|{}|{}", c[0], c[1], c[2], c[3], class(c[6]), c[7].trim()));
+        let key = format!("{}|{}|{}|{}", c[0], c[1], c[2], c[3]);
+        if got_status.get(&key).is_some_and(|g| *g != c[6] && class(g) == class(c[6])) {
+            refined += 1;
+            *pairs.entry(format!("{} -> {}", c[6], got_status[&key])).or_default() += 1;
+        }
+        want_n += 1;
+    }
+    let only_got: Vec<&String> = got.difference(&want).collect();
+    let only_want: Vec<&String> = want.difference(&got).collect();
+    println!("tours evaluated: {got_n}, matrix rows: {want_n}, ambiguous: {ambiguous}, same file with a different proof path (INFO): {refined}");
+    println!("PERF (INFO): evaluate() over {} depot files: mean {:.2} ms, worst {:.1} ms per tour ({} tours)", refs.len(), eval_total.as_secs_f64() * 1000.0 / got_n.max(1) as f64, eval_max.as_secs_f64() * 1000.0, got_n);
+    for (k, v) in &pairs {
+        println!("  INFO proof path changed (same file): {k} x{v}");
+    }
+    for d in only_got.iter().take(40) {
+        println!("  NEW   {d}");
+    }
+    for d in only_want.iter().take(40) {
+        println!("  MATRIX {d}");
+    }
+    // HOF_AUTO_INFO_ONLY=1: a stress universe (e.g. every depot file ever copied, with the same [name] in
+    // several files) that has no approved matrix: report the differences, assert nothing
+    if std::env::var("HOF_AUTO_INFO_ONLY").is_ok_and(|v| v == "1") {
+        verdict(&format!("INFORMATIVO (tours {got_n}, differences from the reference {}, ambiguous {ambiguous})", only_got.len() + only_want.len()));
+        return;
+    }
+    verdict(&format!("{} (tours {got_n}, matrix {want_n}, divergences {})", if only_got.is_empty() && only_want.is_empty() && got_n == want_n { "APROVADO" } else { "REPROVADO" }, only_got.len() + only_want.len()));
+    assert!(only_got.is_empty() && only_want.is_empty(), "{} divergences from the approved matrix", only_got.len() + only_want.len());
+    assert_eq!(got_n, want_n);
+}
